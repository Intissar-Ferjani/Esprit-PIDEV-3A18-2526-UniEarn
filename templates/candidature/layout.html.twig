<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}UniEarn - Module{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="dashboard-body">

<div class="dashboard-layout">
    {# ── Sidebar ── #}
    {% if freelancer is defined and freelancer is not null %}
        {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': active|default('dashboard')} %}
    {% elseif client is defined and client is not null %}
        {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': active|default('dashboard')} %}
    {% else %}
        {# Fallback for Admin or others if they access these routes #}
        {% if user is defined and user is not null %}
            {% if 'FREELANCER' in user.role %}
                {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': active|default('dashboard')} %}
            {% elseif 'CLIENT' in user.role %}
                {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': active|default('dashboard')} %}
            {% endif %}
        {% endif %}
    {% endif %}

    {# ── Main content ── #}
    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">{% block page_title %}Dashboard{% endblock %}</span>
            <div class="top-bar-right">
                <span class="top-bar-user">
                    👤 {{ user.name|default('User') }}
                    {% if freelancer is defined and freelancer is not null %}
                        <small>(Freelancer)</small>
                    {% elseif client is defined and client is not null %}
                        <small>(Client)</small>
                    {% endif %}
                </span>
            </div>
        </div>

        <div class="dashboard-content">
            {# ── PREMIUM NOTIFICATIONS (TOASTS) ── #}
            <div id="premium-toasts" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 12px; pointer-events: none;">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {% set icon = '✨' %}
                        {% set primaryColor = '#4f46e5' %}
                        {% if label == 'success' %}{% set icon = '✅' %}{% set primaryColor = '#10b981' %}{% endif %}
                        {% if label == 'error' %}{% set icon = '🚫' %}{% set primaryColor = '#ef4444' %}{% endif %}
                        {% if label == 'warning' %}{% set icon = '⚠️' %}{% set primaryColor = '#f59e0b' %}{% endif %}

                        <div class="premium-toast" style="
                            pointer-events: auto;
                            min-width: 300px;
                            max-width: 450px;
                            background: rgba(255, 255, 255, 0.95);
                            backdrop-filter: blur(12px);
                            border-left: 5px solid {{ primaryColor }};
                            padding: 16px 20px;
                            border-radius: 12px;
                            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
                            display: flex;
                            align-items: center;
                            gap: 14px;
                            animation: toastSlideIn 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                            font-size: 14px;
                            font-weight: 500;
                            color: #1e293b;
                        ">
                            <span style="font-size: 20px;">{{ icon }}</span>
                            <div style="flex-grow: 1;">{{ message }}</div>
                            <button onclick="this.parentElement.remove()" style="background:none; border:none; cursor:pointer; color:#94a3b8; font-size:18px;">&times;</button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>

            <style>
                @keyframes toastSlideIn {
                    from { transform: translateX(120%); opacity: 0; }
                    to { transform: translateX(0); opacity: 1; }
                }
                .premium-toast { transition: all 0.3s ease; }
            </style>

            {% block content %}{% endblock %}
        </div>
    </div>
</div>
{% block javascripts %}{% endblock %}
</body>
</html>
