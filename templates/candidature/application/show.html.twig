{% extends 'candidature/layout.html.twig' %}

{% block title %}Application Details{% endblock %}
{% block page_title %}Application Details{% endblock %}

{% block content %}
<style>
    .premium-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        padding: 30px;
        margin-bottom: 25px;
        border: 1px solid rgba(226, 232, 240, 0.8);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    }
    .header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 20px;
        margin-bottom: 25px;
    }
    .app-title {
        font-size: 28px;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .status-badge {
        font-size: 14px;
        font-weight: 700;
        padding: 6px 16px;
        border-radius: 20px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .status-PENDING { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; }
    .status-ACCEPTED { background: linear-gradient(135deg, #10b981, #059669); color: white; }
    .status-REJECTED { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }
    .status-DEFAULT { background: linear-gradient(135deg, #64748b, #475569); color: white; }

    .grid-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    .metric-box {
        background: linear-gradient(145deg, #f8fafc, #f1f5f9);
        padding: 20px;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        border: 1px solid #e2e8f0;
        position: relative;
        overflow: hidden;
    }
    .metric-box::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 4px; height: 100%;
        background: #4f46e5;
        border-radius: 4px 0 0 4px;
    }
    .metric-title {
        font-size: 13px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }
    .metric-value {
        font-size: 24px;
        font-weight: 800;
        color: #1e293b;
    }

    .cover-letter-box {
        background: #f8fafc;
        border-left: 4px solid #3b82f6;
        padding: 25px;
        border-radius: 0 12px 12px 0;
        color: #334155;
        font-size: 15px;
        line-height: 1.7;
        font-style: italic;
        position: relative;
        text-transform: none !important;
    }
    
    .action-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        margin-top: 30px;
    }
    
    .btn-premium {
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        color: white;
    }
    .btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.15);
        color: white;
    }
    .btn-back { background: #64748b; }
    .btn-pdf { background: linear-gradient(135deg, #d97706, #b45309); }
    .btn-accept { background: linear-gradient(135deg, #10b981, #059669); }
    .btn-reject { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .btn-delete { background: #475569; }
</style>

<div class="content-section" style="max-width: 900px; margin: 0 auto;">
    
    <div class="premium-card">
        <div class="header-flex">
            <h3 class="app-title">
                <span style="font-size:32px;">📄</span> Application Details
            </h3>
            {% set statusClass = 'status-' ~ application.status.value %}
            {% if statusClass not in ['status-PENDING', 'status-ACCEPTED', 'status-REJECTED'] %}{% set statusClass = 'status-DEFAULT' %}{% endif %}
            <span class="status-badge {{ statusClass }}">{{ application.status.displayName }}</span>
        </div>

        <div class="grid-metrics">
            <div class="metric-box" style="--accent: #4f46e5;">
                <span class="metric-title">Project Name</span>
                <span class="metric-value">{{ projectTitle }}</span>
            </div>
            <div class="metric-box" style="--accent: #10b981;">
                <span class="metric-title">Proposed Budget</span>
                <span class="metric-value" style="color: #10b981;">{{ application.proposedBudget }} TND</span>
                {% if convertedBudgets is defined %}
                    <div style="font-size: 11px; color: #64748b; margin-top: 4px; font-weight: 600;">
                        ≈ {{ convertedBudgets.USD }} USD / {{ convertedBudgets.EUR }} EUR
                    </div>
                {% endif %}
            </div>
            <div class="metric-box" style="--accent: #f59e0b;">
                <span class="metric-title">Duration</span>
                <span class="metric-value">{{ application.estimatedDuration }} Days</span>
            </div>
            <div class="metric-box" style="--accent: #4f46e5;">
                <span class="metric-title">Compatibility</span>
                <div style="display:flex; align-items:center; gap:10px; margin-top:5px;">
                    <div style="flex-grow:1; height:8px; background:#e2e8f0; border-radius:4px; overflow:hidden;">
                        <div style="width:{{ application.compatibilityScore }}%; height:100%; background:linear-gradient(90deg, #4f46e5, #7c3aed);"></div>
                    </div>
                    <span style="font-weight:800; color:#4f46e5; font-size:18px;">{{ application.compatibilityScore }}%</span>
                </div>
            </div>
        </div>

        {% if aiData and freelancer is defined and freelancer is not null %}
            <div style="margin-bottom: 30px; padding: 25px; background: rgba(238, 242, 255, 0.7); backdrop-filter: blur(10px); border-radius: 16px; border: 1px solid #c7d2fe; box-shadow: 0 8px 30px rgba(79, 70, 229, 0.08); position: relative;">
                <div style="position: absolute; top: -15px; left: 25px; background: #4f46e5; color: white; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);">
                    Premium AI Analysis
                </div>
                <div style="display: flex; gap: 20px; align-items: flex-start;">
                    <div style="font-size: 44px; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));">🤖</div>
                    <div style="flex-grow: 1;">
                        <p style="margin: 0 0 12px; color: #312e81; font-size: 15px; line-height: 1.6; font-weight: 500;">"{{ aiData.feedback }}"</p>
                        
                        <div style="display: flex; flex-wrap: wrap; gap: 15px; margin-top: 15px;">
                            <div style="background: white; padding: 8px 16px; border-radius: 10px; border: 1px solid #e0e7ff; display: flex; align-items: center; gap: 8px;">
                                <span style="font-size: 12px; font-weight: 700; color: #6366f1;">SCORE:</span>
                                <span style="font-weight: 800; color: #1e1b4b; font-size: 16px;">{{ (aiData.score * 100)|round }}%</span>
                            </div>
                            
                            {% if aiData.recommendation is defined %}
                                <div style="flex-grow: 1; min-width: 250px; background: #fffbeb; padding: 8px 16px; border-radius: 10px; border: 1px solid #fde68a; font-size: 13px; color: #92400e; display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 18px;">💡</span>
                                    <span><strong>Pro Tip:</strong> {{ aiData.recommendation }}</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <div>
            <h4 style="font-size: 18px; color: #1e293b; margin-bottom: 15px; font-weight: 700;">Cover Letter</h4>
            <div class="cover-letter-box">
                "{{ application.coverLetter|nl2br }}"
            </div>
        </div>

        <div class="action-bar">
            <a href="{{ path('app_application_index') }}" class="btn-premium btn-back">
                <span>⬅</span> Back to List
            </a>
            
            {% if application.status.value != 'PENDING' %}
                <a href="{{ path('app_application_pdf', {'id': application.id}) }}" class="btn-premium btn-pdf">
                    <span>📄</span> Download PDF
                </a>
            {% endif %}
            
            <div style="flex-grow: 1;"></div>
            
            {% if client is defined and client is not null %}
                {% if application.status.value == 'PENDING' %}
                    <form method="post" action="{{ path('app_application_accept', {'id': application.id}) }}" style="display:inline;" onsubmit="return confirm('Accept this application? Other applications for this project will be rejected.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ application.id) }}">
                        <button type="submit" class="btn-premium btn-accept"><span>✓</span> Accept</button>
                    </form>
                    
                    <form method="post" action="{{ path('app_application_reject', {'id': application.id}) }}" style="display:inline;" onsubmit="return confirm('Reject this application?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ application.id) }}">
                        <button type="submit" class="btn-premium btn-reject"><span>✕</span> Reject</button>
                    </form>
                {% endif %}
            {% endif %}

            {% if freelancer is defined and freelancer is not null %}
                 <form method="post" action="{{ path('app_application_delete', {'id': application.id}) }}" style="display:inline;" onsubmit="return confirm('Withdraw this application permanently?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ application.id) }}">
                    <button type="submit" class="btn-premium btn-delete"><span>🛑</span> Withdraw</button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
