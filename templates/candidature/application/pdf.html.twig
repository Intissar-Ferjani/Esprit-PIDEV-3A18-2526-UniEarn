<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Application #{{ application.id }}</title>
    <style>
        @page { margin: 0; }
        body { font-family: 'Helvetica', sans-serif; color: #1e293b; line-height: 1.6; margin: 0; }
        .container { padding: 40px; }
        .hero { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: white; padding: 60px 40px; position: relative; }
        .hero h1 { margin: 0; font-size: 32px; letter-spacing: -0.025em; }
        .hero .badge { background: rgba(255, 255, 255, 0.2); padding: 4px 12px; border-radius: 9999px; font-size: 14px; margin-top: 10px; display: inline-block; }
        
        .section { margin-top: 40px; }
        .section-title { font-size: 18px; font-weight: bold; color: #4f46e5; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; margin-bottom: 20px; text-transform: uppercase; }
        
        .grid { width: 100%; border-collapse: collapse; }
        .grid td { padding: 15px 0; border-bottom: 1px solid #f1f5f9; }
        .label { color: #64748b; font-size: 13px; font-weight: 600; text-transform: uppercase; width: 200px; }
        .value { color: #1e293b; font-size: 15px; font-weight: 500; }
        
        .score-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-top: 20px; }
        .score-row { display: table; width: 100%; }
        .score-item { display: table-cell; width: 50%; }
        .score-label { font-size: 12px; color: #64748b; margin-bottom: 4px; }
        .score-value { font-size: 24px; font-weight: 800; color: #4f46e5; }
        
        .cover-letter { background: #fff; border-left: 4px solid #4f46e5; padding: 20px; font-style: italic; color: #334155; }
        
        .footer { position: fixed; bottom: 0; width: 100%; text-align: center; color: #94a3b8; font-size: 11px; padding: 20px 0; background: #f8fafc; border-top: 1px solid #e2e8f0; }
    </style>
</head>
<body>
    <div class="hero">
        <h1>Application Report</h1>
        <div class="badge">Reference ID: #{{ application.id }}</div>
    </div>

    <div class="container">
        <div class="section">
            <div class="section-title">Professional Assessment</div>
            <div class="score-box">
                <div class="score-row">
                    <div class="score-item">
                        <div class="score-label">Compatibility Score</div>
                        <div class="score-value">{{ application.compatibilityScore }}%</div>
                    </div>
                    {% if aiData %}
                        <div class="score-item">
                            <div class="score-label">AI Professionalism</div>
                            <div class="score-value">{{ (aiData.score * 100)|round }}%</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="section">
            <div class="section-title">Job Details</div>
            <table class="grid">
                <tr>
                    <td class="label">Project ID</td>
                    <td class="value">#{{ application.projectId }}</td>
                </tr>
                <tr>
                    <td class="label">Standard Status</td>
                    <td class="value">{{ application.status.displayName }}</td>
                </tr>
                <tr>
                    <td class="label">Investment Proposal</td>
                    <td class="value">{{ application.proposedBudget|number_format(2) }} TND</td>
                </tr>
                <tr>
                    <td class="label">Execution Timeline</td>
                    <td class="value">{{ application.estimatedDuration }} Days</td>
                </tr>
                <tr>
                    <td class="label">Submission Date</td>
                    <td class="value">{{ application.appliedAt|date('F d, Y \a\t H:i') }}</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <div class="section-title">Candidate's Pitch</div>
            <div class="cover-letter">
                {{ application.coverLetter|nl2br }}
            </div>
        </div>

        {% if aiData %}
            <div class="section">
                <div class="section-title">AI Insight</div>
                <p style="color: #64748b; font-size: 14px;">{{ aiData.feedback }}</p>
            </div>
        {% endif %}
    </div>

    <div class="footer">
        Confidential Document &bull; Generated by UniEarn Intelligence &bull; {{ 'now'|date('Y-m-d') }}
    </div>
</body>
</html>
