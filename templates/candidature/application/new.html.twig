{% extends 'candidature/layout.html.twig' %}

{% block title %}New Application{% endblock %}
{% block page_title %}New Application{% endblock %}

{% block content %}
<style>
    .premium-form-container {
        max-width: 650px; 
        margin: 40px auto; 
        background: #ffffff; 
        padding: 40px; 
        border-radius: 20px; 
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
        position: relative;
    }
    .premium-form-container::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 6px;
        background: linear-gradient(90deg, #3b82f6, #6366f1, #8b5cf6);
        border-radius: 20px 20px 0 0;
    }
    .form-input {
        width: 100%; 
        padding: 14px 16px; 
        border: 2px solid #e2e8f0; 
        border-radius: 10px; 
        box-sizing: border-box;
        font-size: 15px;
        transition: all 0.3s ease;
        background: #f8fafc;
        color: #1e293b;
    }
    .form-input:focus {
        border-color: #6366f1;
        background: #ffffff;
        outline: none;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }
    .form-label {
        display: block; 
        font-weight: 700; 
        color: #334155; 
        margin-bottom: 8px;
        font-size: 14px;
        letter-spacing: 0.5px;
    }
    .submit-btn-premium {
        width: 100%; 
        padding: 16px; 
        font-size: 16px; 
        font-weight: 700; 
        border-radius: 12px; 
        border: none; 
        cursor: pointer; 
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #4f46e5, #3b82f6);
        color: white;
        box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
    }
    .submit-btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(79, 70, 229, 0.4);
    }
</style>

<div class="premium-form-container">
    <div style="text-align: center; margin-bottom: 35px;">
        <span style="font-size: 40px; display: block; margin-bottom: 15px;">🚀</span>
        <h3 style="margin: 0; font-size: 28px; font-weight: 800; color: #0f172a;">Submit Application</h3>
        <p style="margin: 8px 0 0; color: #64748b; font-size: 15px;">Propose your budget, timeline, and introduce yourself brilliantly.</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'form'}}) }}
        
        <div style="margin-bottom: 24px;">
            <label class="form-label">Project ID</label>
            {{ form_widget(form.projectId, {'attr': {'class': 'form-input', 'placeholder': 'Enter the project ID'}}) }}
            <div style="color: #ef4444; font-size: 12px; margin-top: 6px; font-weight: 500;">{{ form_errors(form.projectId) }}</div>
        </div>

        <div style="display: flex; gap: 20px; margin-bottom: 24px;">
            <div style="flex: 1;">
                <label class="form-label">Proposed Budget (TND)</label>
                {{ form_widget(form.proposedBudget, {'attr': {'class': 'form-input', 'placeholder': 'e.g. 500'}}) }}
                <div style="color: #ef4444; font-size: 12px; margin-top: 6px; font-weight: 500;">{{ form_errors(form.proposedBudget) }}</div>
            </div>
            <div style="flex: 1;">
                <label class="form-label">Duration (Days)</label>
                {{ form_widget(form.estimatedDuration, {'attr': {'class': 'form-input', 'placeholder': 'e.g. 14'}}) }}
                <div style="color: #ef4444; font-size: 12px; margin-top: 6px; font-weight: 500;">{{ form_errors(form.estimatedDuration) }}</div>
            </div>
        </div>

        <div style="margin-bottom: 30px;">
            <label class="form-label">Cover Letter</label>
            {{ form_widget(form.coverLetter, {'attr': {'class': 'form-input', 'rows': '6', 'placeholder': 'Write a compelling proposal highlighting why you are the best fit for this project...'}}) }}
            <div style="color: #ef4444; font-size: 12px; margin-top: 6px; font-weight: 500;">{{ form_errors(form.coverLetter) }}</div>
        </div>

        <button class="submit-btn-premium">
            Submit Application
        </button>
    {{ form_end(form) }}

    <div style="margin-top: 30px; text-align: center;">
        <a href="{{ path('app_application_index') }}" style="color: #64748b; font-size: 14px; text-decoration: none; font-weight: 600; padding: 8px 16px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
            ← Cancel and Return
        </a>
    </div>
</div>


{% endblock %}
