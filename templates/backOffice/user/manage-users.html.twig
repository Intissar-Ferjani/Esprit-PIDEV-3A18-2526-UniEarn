<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn – Manage Users</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    <style>
        .users-table { width:100%; border-collapse:collapse; }
        .table-head th { background:#f8f9fa; border-bottom:2px solid #e2e8f0; padding:12px 16px; text-align:left; font-size:13px; font-weight:700; color:#2c3e50; }
        .table-body tr { border-bottom:1px solid #e2e8f0; transition:background .15s; }
        .table-body tr:hover { background:#f0f4ff; }
        .table-body td { padding:12px 16px; font-size:13px; color:#374151; vertical-align:middle; }
        .role-badge { padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700; color:white; }
        .role-admin      { background:#e74c3c; }
        .role-client     { background:#3498db; }
        .role-freelancer { background:#9b59b6; }
        .status-active   { background:#27ae60; color:white; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700; }
        .status-inactive { background:#e74c3c; color:white; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700; }
        .action-btn { padding:5px 12px; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer; border:none; }
        .btn-view       { background:#3498db; color:white; text-decoration:none; }
        .btn-activate   { background:#27ae60; color:white; }
        .btn-deactivate { background:#e74c3c; color:white; }
        .btn-delete     { background:#fff5f5; border:1.5px solid #fc8181; color:#c53030; }
        .filter-bar { display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; }
        .filter-bar input, .filter-bar select { padding:8px 12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:13px; background:#f8fafc; }
        .filter-bar input:focus, .filter-bar select:focus { outline:none; border-color:#2563EB; }
    </style>
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'backOffice/_sidebar.html.twig' with {'active': 'users'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">👥 Manage Users</span>
            <div class="top-bar-right">
                <span class="top-bar-user">👤 {{ adminName }}</span>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {# ── Filter bar ── #}
            <div class="content-section" style="margin-bottom:20px;">
                <form method="get" action="{{ path('admin_manage_users') }}" class="filter-bar">
                    <div>
                        <label class="field-label">Search</label>
                        <input type="text" name="search" value="{{ search }}" placeholder="🔍 Name or email...">
                    </div>
                    <div>
                        <label class="field-label">Role</label>
                        <select name="role">
                            {% for opt in ['All', 'Client', 'Freelancer'] %}
                                <option value="{{ opt }}" {{ role == opt ? 'selected' : '' }}>{{ opt }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="field-label">Status</label>
                        <select name="status">
                            {% for opt in ['All', 'Active', 'Deactivated'] %}
                                <option value="{{ opt }}" {{ status == opt ? 'selected' : '' }}>{{ opt }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="field-label">Sort by</label>
                        <select name="sort">
                            <option value="name_asc"  {{ sort == 'name_asc'  ? 'selected' : '' }}>Name (A-Z)</option>
                            <option value="name_desc" {{ sort == 'name_desc' ? 'selected' : '' }}>Name (Z-A)</option>
                            <option value="email_asc" {{ sort == 'email_asc' ? 'selected' : '' }}>Email (A-Z)</option>
                            <option value="role"      {{ sort == 'role'      ? 'selected' : '' }}>Role</option>
                            <option value="status"    {{ sort == 'status'    ? 'selected' : '' }}>Status</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-edit" style="height:38px;">Apply</button>
                    <a href="{{ path('admin_manage_users') }}" class="back-button" style="height:38px;padding:0 16px;text-decoration:none;display:flex;align-items:center;">Clear</a>
                </form>
            </div>

            {# ── Users table ── #}
            <div class="content-section">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">👥</span>
                        <h3 class="section-title">Users</h3>
                    </div>
                    <span style="color:#64748b;font-size:13px;">{{ users|length }} user{{ users|length != 1 ? 's' : '' }}</span>
                </div>
                <hr class="section-divider">

                {% if users is empty %}
                    <div class="empty-state">
                        <span class="empty-icon">🔍</span>
                        <p class="empty-text">No users found</p>
                        <p class="empty-subtext">Try adjusting your search or filters</p>
                    </div>
                {% else %}
                <div style="overflow-x:auto;">
                <table class="users-table">
                    <thead class="table-head">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="table-body">
                    {% for user in users %}
                        <tr>
                            <td style="font-weight:600;">{{ user.name }}</td>
                            <td style="color:#64748b;">{{ user.email }}</td>
                            <td>
                                <span class="role-badge role-{{ user.role|lower }}">{{ user.role }}</span>
                            </td>
                            <td>
                                {% if user.isActivated %}
                                    <span class="status-active">Active</span>
                                {% else %}
                                    <span class="status-inactive">Deactivated</span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;justify-content:flex-end;">
                                    <a href="{{ path('admin_user_view', {id: user.idUser}) }}" class="action-btn btn-view">👁 View</a>

                                    <form method="post" action="{{ path('admin_toggle_user', {id: user.idUser}) }}" style="display:inline;">
                                        <button type="submit" class="action-btn {{ user.isActivated ? 'btn-deactivate' : 'btn-activate' }}">
                                            {{ user.isActivated ? '🚫 Deactivate' : '✅ Activate' }}
                                        </button>
                                    </form>

                                    <form method="post" action="{{ path('admin_delete_user', {id: user.idUser}) }}"
                                          onsubmit="return confirm('Delete {{ user.name }}? This cannot be undone.')" style="display:inline;">
                                        <button type="submit" class="action-btn btn-delete">🗑 Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
                {% endif %}
            </div>

        </div>
    </div>
</div>
</body>
</html>
