<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn Admin – Forum Post Details</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    <style>
        .post-detail-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }
        .post-title {
            font-size: 24px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 12px;
        }
        .post-meta {
            display: flex;
            gap: 20px;
            color: #64748b;
            font-size: 14px;
            margin-bottom: 20px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 15px;
        }
        .post-content {
            font-size: 16px;
            line-height: 1.6;
            color: #334155;
            white-space: pre-wrap;
        }
        .comments-section {
            margin-top: 40px;
        }
        .comments-title {
            font-size: 20px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'backOffice/_sidebar.html.twig' with {'active': 'forum'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">🔎 Post Moderation</span>
            <div class="top-bar-right">
                <a href="{{ path('admin_forum_index') }}" style="color:#2563EB;text-decoration:none;font-size:13px;">← Back to List</a>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {# ── Post Details ── #}
            <div class="post-detail-card">
                <h1 class="post-title">{{ post.title }}</h1>
                <div class="post-meta">
                    <span>👤 <strong>Author:</strong> {{ authorName }}</span>
                    <span>📁 <strong>Category:</strong> {{ post.category }}</span>
                    <span>📅 <strong>Posted on:</strong> {{ post.createdAt | date('Y-m-d H:i') }}</span>
                </div>
                <div class="post-content">
                    {{ post.content }}
                </div>
            </div>

            {# ── Comments Section ── #}
            <div class="comments-section">
                <h2 class="comments-title">
                    💬 Comments ({{ commentsData | length }})
                </h2>

                <div class="content-section" style="padding:0;overflow:hidden;">
                    <table style="width:100%;border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Author</th>
                                <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Comment</th>
                                <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Date</th>
                                <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for item in commentsData %}
                            <tr style="border-bottom:1px solid #e2e8f0;">
                                <td style="padding:12px 16px;color:#1e293b;font-weight:600;font-size:13px;">{{ item.authorName }}</td>
                                <td style="padding:12px 16px;color:#475569;font-size:13px;">{{ item.comment.commentText }}</td>
                                <td style="padding:12px 16px;color:#64748b;font-size:13px;">{{ item.comment.createdAt | date('Y-m-d H:i') }}</td>
                                <td style="padding:12px 16px;">
                                    <form method="post" action="{{ path('admin_forum_comment_delete', {id: item.comment.commentId}) }}"
                                          onsubmit="return confirm('Delete this comment?')"
                                          style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ item.comment.commentId) }}">
                                        <button type="submit" class="btn-edit" style="background:#ef4444;padding:4px 10px;font-size:11px;">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" style="text-align:center;padding:30px;color:#94a3b8;">
                                    No comments yet for this post.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
</body>
</html>
