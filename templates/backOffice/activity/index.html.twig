<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn – Activity Log</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    <style>
        .log-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            text-align: left;
        }
        .log-table th, .log-table td {
            padding: 12px;
            border-bottom: 1px solid #e2e8f0;
        }
        .log-table th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
        }
        .log-table tr:hover {
            background-color: #f1f5f9;
        }
        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
            color: #fff;
        }
        .badge-CREATE { background-color: #10b981; }
        .badge-UPDATE { background-color: #3b82f6; }
        .badge-DELETE { background-color: #ef4444; }
        
        .changes-box {
            font-family: monospace;
            background: #f8fafc;
            padding: 8px;
            border-radius: 4px;
            color: #334155;
            white-space: pre-wrap;
            word-break: break-all;
            margin: 0;
            max-height: 100px;
            overflow-y: auto;
        }
        .btn-filter {
            background: #1d4ed8;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-filter:hover {
            background: #1e40af;
            transform: translateY(-1px);
        }
        .btn-reset {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }
        .btn-reset:hover {
            background: #e2e8f0;
        }
    </style>
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': 'dashboard'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">👀 System Activity Log</span>
            <div class="top-bar-right">
                <span class="top-bar-user">👤 {{ adminName }}</span>
            </div>
        </div>

        <div class="dashboard-content">
            <div class="content-section">
                <div class="section-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <div class="section-title-wrap">
                        <span class="section-icon">📈</span>
                        <h3 class="section-title">Recent Activities</h3>
                    </div>
                    <form action="{{ path('admin_activity_log') }}" method="get" style="display: flex; gap: 8px; align-items: center;">
                        <select name="action_type" style="padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; background: #fff;">
                            <option value="">All Actions</option>
                            <option value="INSERT" {{ app.request.query.get('action_type') == 'INSERT' ? 'selected' : '' }}>INSERT</option>
                            <option value="UPDATE" {{ app.request.query.get('action_type') == 'UPDATE' ? 'selected' : '' }}>UPDATE</option>
                            <option value="DELETE" {{ app.request.query.get('action_type') == 'DELETE' ? 'selected' : '' }}>DELETE</option>
                        </select>
                        <div style="position: relative;">
                            <input type="number" name="user_id" value="{{ app.request.query.get('user_id') }}" placeholder="User ID..." 
                                   style="padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; width: 120px; outline: none; transition: border-color 0.2s;"
                                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
                        </div>
                        <button type="submit" class="btn-filter">Filter</button>
                        {% if app.request.query.get('user_id') or app.request.query.get('action_type') %}
                            <a href="{{ path('admin_activity_log') }}" class="btn-reset">Reset</a>
                        {% endif %}
                        
                        <a href="{{ path('admin_activity_log_export', app.request.query.all) }}" class="btn-filter" style="background: #10b981; text-decoration: none; display: flex; align-items: center; gap: 5px;">
                            <span>📄</span> Export PDF
                        </a>
                    </form>

                </div>
                <hr class="section-divider">
                
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>User ID</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Entity ID</th>
                            <th>Detailed Changes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td style="white-space: nowrap; color: #64748b;">{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                                <td style="font-weight: bold;">{{ log.userId ? '#' ~ log.userId : 'System/Unknown' }}</td>
                                <td><span class="badge badge-{{ log.actionType|upper }}">{{ log.actionType|upper }}</span></td>
                                <td style="font-weight: bold; color: #0f172a;">{{ log.entityName }}</td>
                                <td>{{ log.entityId }}</td>
                                <td>
                                    {% if log.changes and log.changes|length > 0 %}
                                        <pre class="changes-box">{{ log.changes|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                    {% else %}
                                        <span style="color: #94a3b8; font-style: italic;">No specific diff recorded</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" style="text-align: center; color: #94a3b8; padding: 24px;">No activity logs found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</body>
</html>
