<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn – Admin Dashboard</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': 'dashboard'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">🎯 Admin Dashboard</span>
            <div class="top-bar-right">
                <span class="top-bar-user">👤 {{ adminName }}</span>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <p style="color:#718096;font-size:15px;margin-bottom:28px;">
                Welcome back! Here's what's happening on your platform.
            </p>

            {# ── Stats Cards ── #}
            <div class="stats-row">

                <div class="stat-card" style="border-left:4px solid #2563EB;">
                    <span class="stat-value" style="color:#2563EB;">{{ stats.total }}</span>
                    <span class="stat-label">Total Users</span>
                    <div style="display:flex;gap:16px;margin-top:8px;">
                        <span style="font-size:12px;color:#64748b;">{{ stats.clients }} Clients</span>
                        <span style="font-size:12px;color:#64748b;">{{ stats.freelancers }} Freelancers</span>
                    </div>
                </div>

                <div class="stat-card" style="border-left:4px solid #16a34a;">
                    <span class="stat-value" style="color:#16a34a;">{{ stats.active }}</span>
                    <span class="stat-label">Active Users</span>
                    <span style="font-size:12px;color:#64748b;margin-top:8px;">{{ stats.activePercent }}% of total</span>
                </div>

                <div class="stat-card" style="border-left:4px solid #9333ea;">
                    <span class="stat-value" style="color:#9333ea;">{{ stats.freelancers }}</span>
                    <span class="stat-label">Freelancers</span>
                </div>

                <div class="stat-card" style="border-left:4px solid #ea580c;">
                    <span class="stat-value" style="color:#ea580c;">{{ stats.clients }}</span>
                    <span class="stat-label">Clients</span>
                </div>

            </div>

            {# ── Quick actions ── #}
            <div class="content-section" style="margin-top:8px;">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">⚡</span>
                        <h3 class="section-title">Quick Actions</h3>
                    </div>
                </div>
                <hr class="section-divider">
                <div style="display:flex;gap:12px;flex-wrap:wrap;">
                    <a href="{{ path('admin_manage_users') }}" class="btn-edit">👥 Manage Users</a>
                    <a href="{{ path('admin_contract_index') }}" class="btn-edit" style="background:#9333ea;">📝 Manage Contracts</a>
                    <a href="#" class="btn-edit" style="background:#ea580c;">📊 View Reports</a>
                </div>
            </div>

        </div>
    </div>
</div>
</body>
</html>
