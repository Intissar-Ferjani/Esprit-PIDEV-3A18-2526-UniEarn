{# templates/frontOffice/contract/pagination_blue.html.twig #}
{% if pageCount > 1 %}
    <style>
        .pagi-blue { display: flex; align-items: center; justify-content: center; gap: 10px; list-style: none; padding: 0; font-family: 'Inter', sans-serif; }
        .pagi-blue li a, .pagi-blue li span { 
            display: flex; align-items: center; justify-content: center; width: 40px; height: 40px;
            border-radius: 50%; font-size: 15px; font-weight: 600; text-decoration: none; 
            color: #475569; background: white; border: 1px solid #e2e8f0;
            transition: all 0.3s ease; box-shadow: 0 1px 2px rgba(0,0,0,0.05); cursor: pointer;
        }
        .pagi-blue li a:hover { 
            border-color: #3b82f6; color: #2563eb; 
            box-shadow: 0 4px 10px rgba(59, 130, 246, 0.25); transform: translateY(-2px); 
        }
        .pagi-blue li.active span { 
            background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border: none; 
            box-shadow: 0 4px 10px rgba(59, 130, 246, 0.4); transform: scale(1.05);
        }
        .pagi-blue li.disabled span { 
            opacity: 0.4; cursor: not-allowed; background: #f8fafc; color: #94a3b8; border-color: #f1f5f9; box-shadow: none; transform: none;
        }
        .pagi-icon { font-size: 20px; line-height: 1; padding-bottom: 2px; }
    </style>
    <ul class="pagi-blue">
        {% if previous is defined %}
            <li><a href="{{ path(route, query|merge({(pageParameterName): previous})) }}" title="Précédent"><span class="pagi-icon">&lsaquo;</span></a></li>
        {% else %}
            <li class="disabled"><span class="pagi-icon">&lsaquo;</span></li>
        {% endif %}

        {% for page in pagesInRange %}
            {% if page != current %}
                <li><a href="{{ path(route, query|merge({(pageParameterName): page})) }}">{{ page }}</a></li>
            {% else %}
                <li class="active"><span>{{ page }}</span></li>
            {% endif %}
        {% endfor %}

        {% if next is defined %}
            <li><a href="{{ path(route, query|merge({(pageParameterName): next})) }}" title="Suivant"><span class="pagi-icon">&rsaquo;</span></a></li>
        {% else %}
            <li class="disabled"><span class="pagi-icon">&rsaquo;</span></li>
        {% endif %}
    </ul>
{% endif %}
