<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Client Profile</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <style>
        /* ── Progress steps ───────────────────────── */
        .progress-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
        }
        .step-box { display: flex; flex-direction: column; align-items: center; gap: 5px; }
        .step-circle {
            width: 35px; height: 35px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 14px;
        }
        .step-completed { background: #20C997; color: white; }
        .step-active    { background: #2563EB; color: white; }
        .step-inactive  { background: #e2e8f0; color: #a0aec0; }
        .step-label { font-size: 11px; }
        .label-completed { color: #20C997; }
        .label-active    { color: #2563EB; }
        .step-line { font-size: 16px; font-weight: 700; color: #20C997; margin-bottom: 18px; }

        /* ── Currency prefix ──────────────────────── */
        .input-prefix-wrap { display: flex; align-items: center; gap: 10px; }
        .currency-symbol { font-weight: 700; font-size: 18px; color: #4a5568; }

        /* ── Buttons row ──────────────────────────── */
        .btn-row { display: flex; gap: 15px; margin-top: 10px; }
        .back-button {
            flex: 1; height: 45px;
            background: transparent;
            border: 2px solid #2563EB;
            border-radius: 8px;
            color: #2563EB;
            font-size: 14px; font-weight: 700;
            cursor: pointer;
            transition: background .2s;
        }
        .back-button:hover { background: #edf2f7; }
        .complete-button {
            flex: 1.2; height: 45px;
            background: linear-gradient(to right, #2563EB, #20C997);
            border: none; border-radius: 8px;
            color: white;
            font-size: 14px; font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(37,99,235,.3);
        }
        .complete-button:hover { opacity: .92; }

        .helper-text { color: #718096; font-size: 12px; margin-top: 4px; }
    </style>
</head>
<body>
<div class="root">

    {# ── Left panel ── #}
    <div class="left-panel">
        <span class="brand-title">UniEarn</span>
        <span class="brand-subtitle" style="margin-top:10px;">Almost there!</span>
        <span class="brand-subtitle" style="font-size:14px;margin-top:5px;">Complete your client profile</span>
    </div>

    {# ── Right form panel ── #}
    <div class="form-panel">

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# Progress indicator #}
        <div class="progress-wrap">
            <div class="step-box">
                <div class="step-circle step-completed">1</div>
                <span class="step-label label-completed">Account</span>
            </div>
            <span class="step-line">━━━</span>
            <div class="step-box">
                <div class="step-circle step-active">2</div>
                <span class="step-label label-active">Profile</span>
            </div>
        </div>

        <h1 class="form-title">Client Profile</h1>
        <p class="form-subtitle" style="margin-bottom:30px;">Tell us more about yourself</p>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}, 'action': path('client_setup')}) }}

            {# Amount #}
            <div class="field-wrap">
                {{ form_label(form.amount) }}
                <div class="input-prefix-wrap">
                    <span class="currency-symbol">TND</span>
                    {{ form_widget(form.amount, {'attr': {'class': 'custom-field', 'placeholder': '0.00'}}) }}
                </div>
                <p class="helper-text">Enter the budget you'd like to allocate for projects</p>
                {{ form_errors(form.amount) }}
            </div>

            {# Company #}
            <div class="field-wrap">
                {{ form_label(form.company) }}
                {{ form_widget(form.company, {'attr': {'class': 'custom-field'}}) }}
                {{ form_errors(form.company) }}
            </div>

            {# Industry #}
            <div class="field-wrap">
                {{ form_label(form.industry) }}
                {{ form_widget(form.industry, {'attr': {'class': 'custom-combo'}}) }}
                {{ form_errors(form.industry) }}
            </div>

            {# Buttons #}
            <div class="btn-row">
                <a href="{{ path('user_signup') }}" class="back-button" style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
                    Back
                </a>
                <button type="submit" class="complete-button">Complete Setup</button>
            </div>

        {{ form_end(form) }}

    </div>
</div>
</body>
</html>
