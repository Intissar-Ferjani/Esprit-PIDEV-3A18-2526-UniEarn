<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Client Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/signup.css') }}">
    <style>
        .step-connector {
            flex: 1;
            height: 2px;
            background: #20C997;
            margin: 0 8px;
            margin-bottom: 18px;
        }
        .progress-wrap {
            display: flex;
            align-items: center;
            margin-bottom: 32px;
        }
        .step-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }
        .step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 14px;
        }
        .step-completed { background: #20C997; color: white; }
        .step-active    { background: #2563EB; color: white; }
        .step-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .4px;
        }
        .label-completed { color: #20C997; }
        .label-active    { color: #2563EB; }

        .input-prefix-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .currency-symbol {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 14px;
            color: #2563EB;
            background: #eff6ff;
            padding: 11px 14px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            white-space: nowrap;
        }
        .helper-text {
            font-size: 11px;
            color: #64748b;
            margin-top: 5px;
        }
        .btn-row {
            display: flex;
            gap: 12px;
            margin-top: 8px;
        }
        .back-button {
            flex: 1;
            padding: 14px;
            background: transparent;
            border: 1.5px solid #2563EB;
            border-radius: 12px;
            color: #2563EB;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .2s;
        }
        .back-button:hover { background: #eff6ff; }
    </style>
</head>
<body>
<div class="auth-layout">

    {# ── Left branding panel ── #}
    <div class="auth-left">
        <div class="brand">
            <img src="{{ asset('images/logoUniEarn.png') }}" alt="UniEarn" class="brand-logo">
            <span class="brand-name">UniEarn</span>
        </div>
        <div class="auth-left-body">
            <h2>Almost there!</h2>
            <p>Complete your client profile to start posting projects and hiring talented students.</p>
            <div class="feature-list">
                <div class="feature-item">
                    <div class="feature-dot">🏢</div>
                    <span>Set your company information</span>
                </div>
                <div class="feature-item">
                    <div class="feature-dot">💰</div>
                    <span>Define your initial project budget</span>
                </div>
                <div class="feature-item">
                    <div class="feature-dot">🎯</div>
                    <span>Choose your industry to find the right talent</span>
                </div>
                <div class="feature-item">
                    <div class="feature-dot">🚀</div>
                    <span>Start hiring in minutes</span>
                </div>
            </div>
        </div>
        <div class="auth-left-footer">© 2025 UniEarn. All rights reserved.</div>
    </div>

    {# ── Right form panel ── #}
    <div class="auth-right">
        <div class="auth-card">

            {# ── Progress steps ── #}
            <div class="progress-wrap">
                <div class="step-box">
                    <div class="step-circle step-completed">✓</div>
                    <span class="step-label label-completed">Account</span>
                </div>
                <div class="step-connector"></div>
                <div class="step-box">
                    <div class="step-circle step-active">2</div>
                    <span class="step-label label-active">Profile</span>
                </div>
            </div>

            <div class="auth-card-header">
                <h1>Client Profile</h1>
                <p>Tell us a bit more about yourself to get started</p>
            </div>

            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-wrap">
                        <div class="flash flash-{{ label }}">
                            {{ label == 'error' ? '✕' : '✓' }} {{ message }}
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}, 'action': path('client_setup')}) }}

                {# ── Budget ── #}
                <div class="form-divider">Budget</div>
                <div class="field">
                    {{ form_label(form.amount) }}
                    <div class="input-prefix-wrap">
                        <span class="currency-symbol">TND</span>
                        {{ form_widget(form.amount, {
                            'attr': {
                                'class': 'field-input' ~ (form.amount.vars.errors|length > 0 ? ' has-error' : ''),
                                'placeholder': '0.00'
                            }
                        }) }}
                    </div>
                    <p class="helper-text">Enter the budget you'd like to allocate for projects</p>
                    <div class="field-errors">{{ form_errors(form.amount) }}</div>
                </div>

                {# ── Company & Industry ── #}
                <div class="form-divider">Organization</div>

                <div class="field">
                    {{ form_label(form.company) }}
                    {{ form_widget(form.company, {
                        'attr': {
                            'class': 'field-input' ~ (form.company.vars.errors|length > 0 ? ' has-error' : ''),
                            'placeholder': 'Enter your company name'
                        }
                    }) }}
                    <div class="field-errors">{{ form_errors(form.company) }}</div>
                </div>

                <div class="field">
                    {{ form_label(form.industry) }}
                    {{ form_widget(form.industry, {
                        'attr': {
                            'class': 'field-input' ~ (form.industry.vars.errors|length > 0 ? ' has-error' : '')
                        }
                    }) }}
                    <div class="field-errors">{{ form_errors(form.industry) }}</div>
                </div>

                {# ── Buttons ── #}
                <div class="btn-row">
                    <a href="{{ path('user_signup') }}" class="back-button">← Back</a>
                    <button type="submit" class="btn-submit" style="flex:1.5; margin-top:0;">
                        Complete Setup <span style="margin-left:5px;">→</span>
                    </button>
                </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>
</body>
</html>