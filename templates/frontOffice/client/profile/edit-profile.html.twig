<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn – Edit Profile</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': 'dashboard'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">Edit Profile</span>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <div class="edit-page">
                <div class="edit-card">
                    <div class="edit-card-header" style="padding: 20px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: white; border-radius: 8px 8px 0 0; margin: -20px -20px 0 -20px;">
                    </div>

                    {{ form_start(form, {'attr': {'class': 'edit-form', 'novalidate': 'novalidate'}, 'action': path('client_profile_edit')}) }}

                        <div class="edit-section-title" style="font-size: 14px; font-weight: 600; color: #1e293b; margin-top: 28px; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.5px;">Personal Information</div>
                                                
                        <div class="edit-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 8px;">
                            <div class="field-wrap">
                                {{ form_label(form.name, null, {'label_attr': {'class': 'field-label', 'style': 'display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;'}}) }}
                                {{ form_widget(form.name, {'attr': {'class': 'custom-field', 'style': 'width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; transition: all 0.2s;'}}) }}
                                {{ form_errors(form.name) }}
                            </div>

                            <div class="field-wrap">
                                {{ form_label(form.email, null, {'label_attr': {'class': 'field-label', 'style': 'display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;'}}) }}
                                {{ form_widget(form.email, {'attr': {'class': 'custom-field', 'style': 'width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; transition: all 0.2s;'}}) }}
                                {{ form_errors(form.email) }}
                            </div>

                            <div class="field-wrap">
                                {{ form_label(form.company, null, {'label_attr': {'class': 'field-label', 'style': 'display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;'}}) }}
                                {{ form_widget(form.company, {'attr': {'class': 'custom-field', 'style': 'width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; transition: all 0.2s;'}}) }}
                                {{ form_errors(form.company) }}
                            </div>

                            <div class="field-wrap">
                                {{ form_label(form.industry, null, {'label_attr': {'class': 'field-label', 'style': 'display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;'}}) }}
                                {{ form_widget(form.industry, {'attr': {'class': 'custom-combo', 'style': 'width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; background: white;'}}) }}
                                {{ form_errors(form.industry) }}
                            </div>
                        </div>


                        <div style="border-top: 2px solid #e2e8f0; margin: 28px 0; padding-top: 28px;"></div>
                        
                        <div class="edit-section-title" style="font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">🔒 Change Password</div>
                        <p style="color: #64748b; font-size: 13px; margin-bottom: 20px; line-height: 1.5;">
                            Leave blank to keep your current password.
                        </p>

                        <div class="field-wrap" style="margin-bottom: 16px;">
                            {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'field-label', 'style': 'display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;'}}) }}
                            {{ form_widget(form.currentPassword, {'attr': {'class': 'custom-field', 'style': 'width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; transition: all 0.2s;'}}) }}
                            {{ form_errors(form.currentPassword) }}
                        </div>

                        <div class="field-wrap" style="margin-bottom: 16px;">
                            {{ form_label(form.newPassword, null, {'label_attr': {'class': 'field-label', 'style': 'display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;'}}) }}
                            {{ form_widget(form.newPassword, {'attr': {
                                'class': 'custom-field',
                                'id': 'newPassword',
                                'style': 'width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; transition: all 0.2s;'
                            }}) }}
                            <div id="password-strength-container" style="display:none; margin-top:10px;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; font-size:11px; font-weight:700; color:#64748b;">
                                    <span>Password Strength</span>
                                    <span id="password-strength-text" style="color:#ef4444;">Weak</span>
                                </div>
                                <div style="height:6px; background:#e2e8f0; border-radius:4px; overflow:hidden;">
                                    <div id="password-strength-bar" style="width:0%; height:100%; background:#ef4444; transition:all 0.3s ease;"></div>
                                </div>
                            </div>
                            {{ form_errors(form.newPassword) }}
                        </div>

                        <div class="field-wrap">
                            {{ form_label(form.confirmPassword, null, {'label_attr': {'class': 'field-label', 'style': 'display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;'}}) }}
                            {{ form_widget(form.confirmPassword, {'attr': {'class': 'custom-field', 'style': 'width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; transition: all 0.2s;'}}) }}
                            {{ form_errors(form.confirmPassword) }}
                        </div>

                        <div class="btn-row" style="display: flex; gap: 12px; margin-top: 28px;">
                            <a href="{{ path('client_dashboard') }}" class="back-button"
                            style="flex: 1; text-decoration: none; display: flex; align-items: center; justify-content: center; padding: 12px 20px; border: 1.5px solid #cbd5e1; border-radius: 6px; color: #2563eb; font-weight: 600; font-size: 14px; transition: all 0.2s; cursor: pointer;">
                                Cancel
                            </a>
                            <button type="submit" class="signup-button" style="flex: 1.2; padding: 12px 20px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);">Save Changes</button>
                        </div>

                    {{ form_end(form) }}

                    {# Danger Zone — separate form, outside Symfony form #}
                    <div class="danger-zone" style="border: 1.5px solid #fee2e2; background: #fef2f2; border-radius: 8px; padding: 20px; margin-top: 28px;">
                        <p class="danger-title" style="color: #dc2626; font-weight: 700; font-size: 14px; margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px;">⚠ Danger Zone</p>
                        <p class="danger-desc" style="color: #7f1d1d; font-size: 13px; margin: 0 0 16px 0; line-height: 1.5;">Once you deactivate your account, there is no going back.</p>
                        <button class="btn-deactivate"
                                onclick="document.getElementById('deactivateModal').style.display='flex'"
                                style="padding: 10px 16px; background: #dc2626; color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s;">
                            Deactivate Account
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{# Deactivate modal #}
<div id="deactivateModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.4); flex-direction: column; align-items: center; justify-content: center; z-index: 1000;">
    <div class="modal-box" style="background: white; border-radius: 8px; padding: 28px; max-width: 400px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);">
        <h3 style="color: #dc2626; margin-bottom: 12px; font-weight: 700; font-size: 16px;">⚠ Deactivate Account</h3>
        <p style="color: #64748b; margin-bottom: 20px; font-size: 13px; line-height: 1.6;">
            Are you absolutely sure? Type <strong>DEACTIVATE</strong> to confirm.
        </p>
        <form method="post" action="{{ path('client_deactivate') }}">
            <input type="text" name="confirm_text" class="custom-field"
                   placeholder="Type DEACTIVATE" style="width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; margin-bottom: 20px; box-sizing: border-box;">
            <div class="btn-row" style="display: flex; gap: 12px;">
                <button type="button" class="back-button"
                        onclick="document.getElementById('deactivateModal').style.display='none'"
                        style="flex: 1; padding: 10px 16px; border: 1.5px solid #cbd5e1; border-radius: 6px; background: white; color: #2563eb; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s;">
                    Cancel
                </button>
                <button type="submit" class="btn-deactivate" style="flex: 1; padding: 10px 16px; background: #dc2626; color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s;">Confirm Deactivate</button>
            </div>
        </form>
    </div>
</div>

<script>
// Password Strength Calculator
document.addEventListener('DOMContentLoaded', function() {
    const passwordField = document.getElementById('newPassword');
    const strengthContainer = document.getElementById('password-strength-container');
    const strengthText = document.getElementById('password-strength-text');
    const strengthBar = document.getElementById('password-strength-bar');

    if (!passwordField) return;

    passwordField.addEventListener('input', function() {
        const password = this.value;
        if (password.length === 0) {
            strengthContainer.style.display = 'none';
            return;
        }
        strengthContainer.style.display = 'block';
        
        let strength = 0;
        if (password.length >= 8) strength += 1;
        if (password.match(/[A-Z]/) && password.match(/[a-z]/)) strength += 1;
        if (password.match(/[0-9]/)) strength += 1;
        if (password.match(/[^A-Za-z0-9]/)) strength += 1;

        switch(strength) {
            case 0:
            case 1:
                strengthBar.style.width = '33%';
                strengthBar.style.background = '#ef4444';
                strengthText.textContent = 'Weak';
                strengthText.style.color = '#ef4444';
                break;
            case 2:
            case 3:
                strengthBar.style.width = '66%';
                strengthBar.style.background = '#f59e0b';
                strengthText.textContent = 'Medium';
                strengthText.style.color = '#f59e0b';
                break;
            case 4:
                strengthBar.style.width = '100%';
                strengthBar.style.background = '#10b981';
                strengthText.textContent = 'Strong';
                strengthText.style.color = '#10b981';
                break;
        }
    });
});
</script>
</body>
</html>