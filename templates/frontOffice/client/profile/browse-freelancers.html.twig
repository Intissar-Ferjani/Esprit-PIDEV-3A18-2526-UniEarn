<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Browse Freelancers</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    <style>
        /* ── Freelancer card ─────────────────────────────────────── */
        .freelancer-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,.05);
            transition: box-shadow .2s, border-color .2s;
            margin-bottom: 14px;
        }
        .freelancer-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.09); border-color:#bfdbfe; }

        .f-avatar {
            width: 72px; height: 72px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #e2e8f0;
            flex-shrink: 0;
        }

        .f-info { flex: 1; min-width: 0; }

        .f-name-row { display:flex; align-items:center; gap:10px; margin-bottom:4px; flex-wrap:wrap; }
        .f-name { font-size:17px; font-weight:700; color:#1a202c; }

        .verified-badge {
            background:#e6f4ea; color:#2e7d32;
            padding:2px 10px; border-radius:20px;
            font-size:11px; font-weight:700;
        }
        .unverified-badge {
            background:#fef3c7; color:#b45309;
            padding:2px 10px; border-radius:20px;
            font-size:11px; font-weight:700;
        }

        .f-email { font-size:13px; color:#64748b; margin-bottom:8px; }

        .f-stats { display:flex; gap:20px; margin-bottom:10px; flex-wrap:wrap; }
        .f-stat { font-size:14px; font-weight:700; }
        .f-stat-rating { color:#f59e0b; }
        .f-stat-price  { color:#16a34a; }

        .f-skills { display:flex; flex-wrap:wrap; gap:6px; }
        .f-skill {
            background:#e8f0fe; color:#1a73e8;
            padding:3px 10px; border-radius:20px;
            font-size:11px; font-weight:600;
        }
        .f-skill-more { color:#94a3b8; font-size:12px; align-self:center; }

        .btn-view-profile {
            background:#2563EB; color:white;
            border:none; border-radius:8px;
            padding:10px 20px; font-size:13px; font-weight:700;
            cursor:pointer; white-space:nowrap;
            transition: background .2s;
        }
        .btn-view-profile:hover { background:#1d4ed8; }

        /* ── Filter bar ─────────────────────────────────────────── */
        .filter-bar {
            display:flex; gap:12px; flex-wrap:wrap;
            align-items:flex-end; padding:20px 24px;
            background:white; border-radius:12px;
            box-shadow:0 2px 6px rgba(0,0,0,.05);
            margin-bottom:20px;
        }
        .filter-bar input, .filter-bar select {
            padding:9px 13px; border:1.5px solid #e2e8f0;
            border-radius:8px; font-size:13px;
            background:#f8fafc; color:#2d3748;
            transition: border-color .2s;
        }
        .filter-bar input:focus, .filter-bar select:focus {
            outline:none; border-color:#2563EB;
        }
        .filter-group { display:flex; flex-direction:column; gap:4px; }
        .filter-group label { font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; }

        /* ── Profile modal ──────────────────────────────────────── */
        .profile-modal {
            display:none; position:fixed; inset:0;
            background:rgba(0,0,0,.5); z-index:1000;
            align-items:center; justify-content:center;
        }
        .profile-modal-box {
            background:white; border-radius:14px;
            width:620px; max-width:95vw; max-height:88vh;
            overflow-y:auto;
            box-shadow:0 12px 40px rgba(0,0,0,.2);
        }
        .modal-header {
            background:linear-gradient(135deg,#2563EB,#20C997);
            padding:28px; text-align:center; color:white;
            border-radius:14px 14px 0 0;
        }
        .modal-avatar {
            width:90px; height:90px; border-radius:50%;
            object-fit:cover; border:4px solid rgba(255,255,255,.5);
            margin-bottom:12px;
        }
        .modal-name  { font-size:22px; font-weight:700; margin-bottom:4px; }
        .modal-email { font-size:13px; opacity:.85; }
        .modal-body  { padding:24px; }
        .modal-stats {
            display:flex; gap:0; background:#f8fafc;
            border-radius:10px; overflow:hidden; margin-bottom:20px;
        }
        .modal-stat {
            flex:1; padding:16px; text-align:center;
            border-right:1px solid #e2e8f0;
        }
        .modal-stat:last-child { border-right:none; }
        .modal-stat-label { font-size:11px; color:#94a3b8; font-weight:700; text-transform:uppercase; margin-bottom:4px; }
        .modal-stat-value { font-size:20px; font-weight:700; color:#1e293b; }
        .modal-section-title { font-size:15px; font-weight:700; color:#1e293b; margin-bottom:10px; }
        .modal-bio { color:#4a5568; font-size:14px; line-height:1.7; margin-bottom:20px; }
        .modal-skills { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px; }
        .modal-skill {
            background:#e8f0fe; color:#1a73e8;
            padding:6px 14px; border-radius:20px;
            font-size:12px; font-weight:600;
        }
        .modal-close {
            width:100%; padding:12px; background:#f1f5f9;
            border:none; border-radius:0 0 14px 14px;
            font-size:14px; font-weight:600; color:#64748b;
            cursor:pointer; transition: background .2s;
        }
        .modal-close:hover { background:#e2e8f0; }
    </style>
</head>
<script>
(function () {
    const form    = document.querySelector('.filter-bar');
    const search  = form.querySelector('input[name="search"]');
    const selects = form.querySelectorAll('select');
    let timer;

    function submit() { form.submit(); }

    search.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(submit, 400);
    });

    selects.forEach(s => s.addEventListener('change', submit));
})();
</script>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': 'freelancers'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">👥 Browse Freelancers</span>
            <div class="top-bar-right">
                <span class="top-bar-user">👤 {{ user.name }}</span>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {# ── Filter bar ── #}
            <form method="get" action="{{ path('client_browse_freelancers') }}" class="filter-bar">
                <div class="filter-group" style="flex:1;min-width:200px;">
                    <label>Search</label>
                    <input type="text" name="search" value="{{ search }}"
                           placeholder="🔍 Name, skills, or bio...">
                </div>

                <div class="filter-group">
                    <label>Verification</label>
                    <select name="verification">
                        {% for opt in ['All', 'verified', 'unverified'] %}
                            <option value="{{ opt }}" {{ verification == opt ? 'selected' : '' }}>
                                {{ opt == 'verified' ? 'Verified' : (opt == 'unverified' ? 'Unverified' : 'All') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label>Min Rating</label>
                    <select name="rating">
                        {% for opt in ['Any', '4.0+', '4.5+'] %}
                            <option value="{{ opt }}" {{ minRating == opt ? 'selected' : '' }}>{{ opt }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label>Sort by</label>
                    <select name="sort">
                        <option value="rating_high" {{ sort == 'rating_high' ? 'selected' : '' }}>Rating (High)</option>
                        <option value="rating_low"  {{ sort == 'rating_low'  ? 'selected' : '' }}>Rating (Low)</option>
                        <option value="price_low"   {{ sort == 'price_low'   ? 'selected' : '' }}>Price (Low)</option>
                        <option value="price_high"  {{ sort == 'price_high'  ? 'selected' : '' }}>Price (High)</option>
                        <option value="name_asc"    {{ sort == 'name_asc'    ? 'selected' : '' }}>Name (A-Z)</option>
                    </select>
                </div>

                <div class="filter-group" style="justify-content:flex-end;">
                    <label>&nbsp;</label>
                    <div style="display:flex;gap:8px;">
                        <button type="submit" class="btn-edit" style="height:40px;padding:0 18px;">Apply</button>
                        <a href="{{ path('client_browse_freelancers') }}" class="back-button"
                           style="height:40px;padding:0 14px;text-decoration:none;display:flex;align-items:center;">Clear</a>
                    </div>
                </div>
            </form>

            {# ── Results count ── #}
            <p style="color:#64748b;font-size:13px;margin-bottom:16px;">
                {{ count }} freelancer{{ count != 1 ? 's' : '' }} found
            </p>

            {# ── Freelancer cards ── #}
            {% if freelancers is empty %}
                <div class="empty-state">
                    <span class="empty-icon">🔍</span>
                    <p class="empty-text">No freelancers found</p>
                    <p class="empty-subtext">Try adjusting your search or filters</p>
                </div>
            {% else %}
                {% for f in freelancers %}
                <div class="freelancer-card">

                    {# Avatar #}
                    {% if f.profilePicturePath %}
                        <img src="{{ asset(f.profilePicturePath) }}" class="f-avatar" alt="{{ f.name }}">
                    {% else %}
                        <img src="{{ asset('images/default-avatar.jpg') }}" class="f-avatar" alt="{{ f.name }}">
                    {% endif %}

                    {# Info #}
                    <div class="f-info">
                        <div class="f-name-row">
                            <span class="f-name">{{ f.name }}</span>
                            {% if f.verificationStatus == 'verified' %}
                                <span class="verified-badge">✓ Verified</span>
                            {% else %}
                                <span class="unverified-badge">⏳ Unverified</span>
                            {% endif %}
                        </div>
                        <div class="f-email">📧 {{ f.email }}</div>
                        <div class="f-stats">
                            <span class="f-stat f-stat-rating">⭐ {{ f.rating }}</span>
                            <span class="f-stat f-stat-price">💰 {{ f.pricePerHour }} TND/hr</span>
                        </div>
                        {% set skills = f.skillsArray %}
                        {% if skills is not empty %}
                        <div class="f-skills">
                            {% for skill in skills|slice(0, 3) %}
                                <span class="f-skill">{{ skill }}</span>
                            {% endfor %}
                            {% if skills|length > 3 %}
                                <span class="f-skill-more">+{{ skills|length - 3 }} more</span>
                            {% endif %}
                        </div>
                        {% endif %}
                    </div>

                    {# Remove the old modal button, replace with this #}
                    <a href="{{ path('client_view_freelancer', {id: f.idFreelancer}) }}"
                    class="btn-view-profile">
                        View Profile
                    </a>
                </div>
                {% endfor %}
            {% endif %}

        </div>
    </div>
</div>

{# ── Profile modal ── #}
<div id="profileModal" class="profile-modal">
    <div class="profile-modal-box">
        <div class="modal-header">
            <img id="modalAvatar" src="" class="modal-avatar" alt="Avatar">
            <div class="modal-name"  id="modalName"></div>
            <div class="modal-email" id="modalEmail"></div>
        </div>
        <div class="modal-body">
            <div class="modal-stats">
                <div class="modal-stat">
                    <div class="modal-stat-label">⭐ Rating</div>
                    <div class="modal-stat-value" id="modalRating"></div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">💰 Price/hr</div>
                    <div class="modal-stat-value" id="modalPrice"></div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">✓ Status</div>
                    <div class="modal-stat-value" id="modalStatus"></div>
                </div>
            </div>

            <div id="modalBioSection">
                <p class="modal-section-title">About</p>
                <p class="modal-bio" id="modalBio"></p>
            </div>

            <div id="modalSkillsSection">
                <p class="modal-section-title">Skills</p>
                <div class="modal-skills" id="modalSkills"></div>
            </div>
        </div>
        <button class="modal-close" onclick="closeProfile()">Close</button>
    </div>
</div>

<script>
function openProfile(btn) {
    const name   = btn.dataset.name;
    const email  = btn.dataset.email;
    const avatar = btn.dataset.avatar;
    const rating = parseFloat(btn.dataset.rating);
    const price  = parseFloat(btn.dataset.price);
    const status = btn.dataset.status;
    const bio    = btn.dataset.bio;
    const skills = JSON.parse(btn.dataset.skills || '[]');

    document.getElementById('modalAvatar').src         = avatar;
    document.getElementById('modalName').textContent   = name;
    document.getElementById('modalEmail').textContent  = email;
    document.getElementById('modalRating').textContent = rating.toFixed(1);
    document.getElementById('modalPrice').textContent  = price.toFixed(2) + ' TND';
    document.getElementById('modalStatus').textContent = status === 'verified' ? '✅ Verified' : '⏳ Unverified';

    const bioSection = document.getElementById('modalBioSection');
    const bioEl      = document.getElementById('modalBio');
    if (bio && bio.trim()) {
        bioEl.textContent        = bio;
        bioSection.style.display = 'block';
    } else {
        bioSection.style.display = 'none';
    }

    const skillsSection = document.getElementById('modalSkillsSection');
    const skillsEl      = document.getElementById('modalSkills');
    skillsEl.innerHTML  = '';
    if (skills && skills.length > 0) {
        skills.forEach(skill => {
            const span       = document.createElement('span');
            span.className   = 'modal-skill';
            span.textContent = skill;
            skillsEl.appendChild(span);
        });
        skillsSection.style.display = 'block';
    } else {
        skillsSection.style.display = 'none';
    }

    document.getElementById('profileModal').style.display = 'flex';
}

function closeProfile() {
    document.getElementById('profileModal').style.display = 'none';
}

document.getElementById('profileModal').addEventListener('click', function(e) {
    if (e.target === this) closeProfile();
});

</script>

</body>
</html>
