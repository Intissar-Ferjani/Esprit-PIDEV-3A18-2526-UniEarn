{# templates/frontOffice/client/dashboard.html.twig
   viewerRole = 'CLIENT' (own dashboard) | 'ADMIN' (admin viewing this profile)
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – {{ user.name }}'s Profile</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
</head>
<body class="dashboard-body">

<div class="dashboard-layout">

    {# Sidebar — client sees client sidebar, admin sees admin sidebar #}
    {% set sidebar = sidebarInclude ?? 'frontOffice/user/profile/_sidebar.html.twig' %}
    {% set active  = sidebarActive  ?? 'dashboard' %}
    {% include sidebar with {'active': active} %}

    <div class="dashboard-main">

        <div class="top-bar">
            {% if viewerRole is defined and viewerRole == 'ADMIN' and backUrl is defined %}
                <div style="display:flex;align-items:center;gap:12px;">
                    <a href="{{ backUrl }}" style="color:#2563EB;text-decoration:none;font-size:13px;font-weight:600;">
                        ← Back to Users
                    </a>
                    <span style="color:#cbd5e0;">|</span>
                    <span class="top-bar-title">{{ user.name }}'s Profile</span>
                </div>
            {% else %}
                <span class="top-bar-title">Dashboard</span>
            {% endif %}
            <div class="top-bar-right">
                <span class="top-bar-user">👤 {{ user.name }}</span>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {# ── Profile Header Card ── #}
            <div class="profile-header-card">
                <div class="profile-banner"></div>
                <div class="profile-header-body">

                    {# Avatar — editable only by the client themselves #}
                    <div class="avatar-wrap">
                        {% if viewerRole is not defined or viewerRole == 'CLIENT' %}
                            <form method="post" action="{{ path('client_change_photo') }}"
                                  enctype="multipart/form-data" id="photoForm">
                                <label for="photoInput" class="avatar-label" title="Change photo">
                                    {% if user.profilePicturePath %}
                                        <img src="{{ asset(user.profilePicturePath) }}" class="profile-avatar" alt="Avatar">
                                    {% else %}
                                        <img src="{{ asset('images/default-avatar.jpg') }}" class="profile-avatar" alt="Avatar">
                                    {% endif %}
                                    <span class="avatar-camera">📷</span>
                                </label>
                                <input type="file" id="photoInput" name="profile_photo" accept="image/*"
                                       style="display:none" onchange="document.getElementById('photoForm').submit()">
                            </form>
                        {% else %}
                            <img src="{{ asset(user.profilePicturePath ?? 'images/default-avatar.jpg') }}"
                                class="profile-avatar" alt="{{ user.name }}">
                        {% endif %}
                    </div>

                    {# Info #}
                    <div class="profile-info">
                        <h2 class="profile-name">{{ user.name }}</h2>
                        <p class="profile-email">{{ user.email }}</p>
                        <div class="profile-pills">
                            <span class="pill pill-blue">🏢 {{ client.company ?: 'No Company' }}</span>
                            <span class="pill pill-green">🏭 {{ client.industry ?: 'Not Specified' }}</span>
                        </div>
                    </div>

                    {# Edit button — only for the client themselves #}
                    {% if viewerRole is not defined or viewerRole == 'CLIENT' %}
                    <div class="profile-edit-btn-wrap">
                        <a href="{{ path('client_profile_edit') }}" class="btn-edit">✏️ Edit Profile</a>
                    </div>
                    {% endif %}

                    {# Admin actions — activate/deactivate #}
                    {% if viewerRole == 'ADMIN' %}
                    <div class="profile-edit-btn-wrap" style="display:flex;gap:8px;flex-direction:column;align-items:flex-end;">
                        <form method="post" action="{{ path('admin_toggle_user', {id: user.idUser}) }}">
                            <button type="submit" class="btn-edit"
                                    style="background:{{ user.isActivated ? '#f59e0b' : '#16a34a' }};">
                                {{ user.isActivated ? '🚫 Deactivate' : '✅ Activate' }}
                            </button>
                        </form>
                        <form method="post" action="{{ path('admin_delete_user', {id: user.idUser}) }}"
                            onsubmit="return confirm('Delete this user permanently?')">
                            <button type="submit" class="btn-edit" style="background:#ef4444;">🗑 Delete</button>
                        </form>
                    </div>
                    {% endif %}

                </div>
            </div>

            {# ── Client Details (admin only extra info) ── #}
            {% if viewerRole == 'ADMIN' and client %}
            <div class="content-section" style="margin-top:20px;">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">📊</span>
                        <h3 class="section-title">Client Details</h3>
                    </div>
                </div>
                <hr class="section-divider">
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
                    <div>
                        <p class="field-label">Company</p>
                        <p style="font-weight:600;color:#1e293b;">{{ client.company ?: 'N/A' }}</p>
                    </div>
                    <div>
                        <p class="field-label">Industry</p>
                        <p style="font-weight:600;color:#1e293b;">{{ client.industry ?: 'N/A' }}</p>
                    </div>
                    <div>
                        <p class="field-label">Balance</p>
                        <p style="font-weight:600;color:#1e293b;">{{ client.amount }} TND</p>
                    </div>
                    <div>
                        <p class="field-label">Rating</p>
                        <p style="font-weight:600;color:#1e293b;">⭐ {{ client.rating }}</p>
                    </div>
                    <div>
                        <p class="field-label">Status</p>
                        <p style="font-weight:600;color:{{ user.isActivated ? '#16a34a' : '#dc2626' }};">
                            {{ user.isActivated ? '✅ Active' : '🚫 Deactivated' }}
                        </p>
                    </div>
                </div>
            </div>
            {% endif %}

            {# ── Posted Projects — only shown to the client themselves ── #}
            {% if viewerRole is not defined or viewerRole == 'CLIENT' %}
            <div class="content-section" style="margin-top:24px;">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">📁</span>
                        <h3 class="section-title">Posted Projects</h3>
                    </div>
                </div>
                <hr class="section-divider">
                <div class="empty-state">
                    <span class="empty-icon">📋</span>
                    <p class="empty-text">No projects posted yet</p>
                    <p class="empty-subtext">Post your first project to get started!</p>
                </div>
            </div>
            {% endif %}

        </div>
    </div>
</div>

</body>
</html>
