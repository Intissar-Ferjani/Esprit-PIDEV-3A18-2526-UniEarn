{# templates/backOffice/user/index.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn Admin – Users</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f8fafc; padding: 2rem; }
        table { width: 100%; border-collapse: collapse; background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
        th { background: #2563EB; color: white; padding: 12px 16px; text-align: left; }
        td { padding: 11px 16px; border-bottom: 1px solid #e2e8f0; }
        tr:last-child td { border-bottom: none; }
        .badge { padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-active   { background: #d1fae5; color: #065f46; }
        .badge-inactive { background: #fee2e2; color: #991b1b; }
        .btn { padding: 5px 14px; border-radius: 6px; border: none; cursor: pointer; font-size: 13px; }
        .btn-danger  { background: #ef4444; color: white; }
        .btn-warning { background: #f59e0b; color: white; }
        .btn-info    { background: #3b82f6; color: white; }
        h1 { color: #1e293b; margin-bottom: 1.5rem; }
    </style>
</head>
<body>

<h1>User Management</h1>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash flash-{{ label }}" style="padding:10px;margin-bottom:1rem;border-radius:6px;background:{% if label=='success' %}#d1fae5{% else %}#fee2e2{% endif %};">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for user in users %}
        <tr>
            <td>{{ user.idUser }}</td>
            <td>
                {% if user.profilePicturePath %}
                    <img src="{{ asset(user.profilePicturePath) }}"
                         style="width:32px;height:32px;border-radius:50%;object-fit:cover;margin-right:8px;vertical-align:middle;">
                {% endif %}
                {{ user.name }}
            </td>
            <td>{{ user.email }}</td>
            <td><span class="badge badge-active">{{ user.role }}</span></td>
            <td>
                {% if user.isActivated %}
                    <span class="badge badge-active">Active</span>
                {% else %}
                    <span class="badge badge-inactive">Inactive</span>
                {% endif %}
            </td>
            <td style="display:flex;gap:6px;">

                {# View #}
                <a href="{{ path('admin_user_show', {id: user.idUser}) }}" class="btn btn-info">View</a>

                {# Activate / Deactivate #}
                <form method="post" action="{{ path('admin_user_toggle', {id: user.idUser}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_' ~ user.idUser) }}">
                    <button type="submit" class="btn btn-warning">
                        {{ user.isActivated ? 'Deactivate' : 'Activate' }}
                    </button>
                </form>

                {# Delete #}
                <form method="post" action="{{ path('admin_user_delete', {id: user.idUser}) }}"
                      onsubmit="return confirm('Are you sure you want to delete {{ user.name }}?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.idUser) }}">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="6" style="text-align:center;color:#94a3b8;">No users found.</td></tr>
    {% endfor %}
    </tbody>
</table>

</body>
</html>
