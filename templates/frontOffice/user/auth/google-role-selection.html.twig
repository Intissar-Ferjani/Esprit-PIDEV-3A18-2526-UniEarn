{% extends 'base.html.twig' %}
{% block title %}Complete Registration – UniEarn{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/signup.css') }}">
<style>
    .auth-card { max-width: 500px; }
    .role-selection-wrap { text-align: center; padding: 20px 0; }
</style>
{% endblock %}

{% block body %}
<div class="auth-layout">
    <div class="auth-left">
        <div class="brand">
            <img src="{{ asset('images/logoUniEarn.png') }}" alt="UniEarn" class="brand-logo">
            <span class="brand-name">UniEarn</span>
        </div>
        <div class="auth-left-body">
            <h2>Welcome to UniEarn, {{ user_name }}!</h2>
            <p>One last step to finish your registration. Tell us how you plan to use the platform.</p>
        </div>
        <div class="auth-left-footer">© 2025 UniEarn. All rights reserved.</div>
    </div>

    <div class="auth-right">
        <div class="auth-card">
            <div class="auth-card-header" style="text-align: center;">
                <h1>Almost there!</h1>
                <p>Please select your account type</p>
            </div>

            <form method="post">
                <div class="role-cards" style="display:flex;justify-content: center;gap: 24px;">
                    <div>
                        <input type="radio" name="role" value="CLIENT" id="role_client" class="role-card-input" required>
                        <label for="role_client" class="role-card-label">
                            <span class="role-card-icon">🏢</span>
                            <span class="role-card-name">Client</span>
                            <span class="role-card-desc">Post projects & hire talent</span>
                        </label>
                    </div>
                    <div>
                        <input type="radio" name="role" value="FREELANCER" id="role_freelancer" class="role-card-input" required>
                        <label for="role_freelancer" class="role-card-label">
                            <span class="role-card-icon">💼</span>
                            <span class="role-card-name">Freelancer</span>
                            <span class="role-card-desc">Offer skills & earn money</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-submit" style="display:block; margin: 32px auto 0;">
                    Complete Setup →
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
