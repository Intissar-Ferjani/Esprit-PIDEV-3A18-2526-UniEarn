{% extends 'base.html.twig' %}
{% block title %}Reset Password – UniEarn{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/signup.css') }}">
<style>
    .auth-card { max-width: 480px; }
    .code-input { 
        text-align: center; 
        font-size: 28px; 
        letter-spacing: 12px; 
        font-weight: 800; 
        color: #2563EB;
        text-transform: uppercase;
    }
    .code-input::placeholder { letter-spacing: normal; font-size: 14px; font-weight: 400; color: #94a3b8; }
</style>
{% endblock %}

{% block body %}
<div class="auth-layout">
    <div class="auth-left">
        <div class="brand">
            <img src="{{ asset('images/logoUniEarn.png') }}" alt="UniEarn" class="brand-logo">
            <span class="brand-name">UniEarn</span>
        </div>
        <div class="auth-left-body">
            <h2>Reset Password</h2>
            <p>We've sent a 6-digit code to your email. Enter it below along with your new password.</p>
            <div class="feature-list">
                <div class="feature-item"><div class="feature-dot">🛡️</div><span>Passwords are encrypted</span></div>
                <div class="feature-item"><div class="feature-dot">✅</div><span>Instant account recovery</span></div>
            </div>
        </div>
        <div class="auth-left-footer">© 2025 UniEarn. All rights reserved.</div>
    </div>

    <div class="auth-right">
        <div class="auth-card">
            <div class="auth-card-header">
                <h1>Complete Reset</h1>
                <p>Check your email for the verification code</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-wrap">
                        <div class="flash flash-{{ label }}">{{ label == 'error' ? '✕' : '✓' }} {{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post">
                <div class="field">
                    <label class="field-label">Verification Code</label>
                    <input type="text" name="code" class="field-input code-input" placeholder="000000" maxlength="6" required autofocus>
                    <div style="text-align: right; margin-top: 8px;">
                        <span id="resend-timer" style="font-size: 13px; color: #94a3b8; display: none;">You can resend in <span id="timer-seconds">30</span>s</span>
                        <a href="{{ path('user_resend_code') }}" id="resend-link" style="font-size: 13px; color: #2563EB; text-decoration: none; font-weight: 600;">Didn't receive it? Resend code</a>
                    </div>
                </div>

                <button type="submit" class="btn-submit" style="display:block; margin: 24px auto 0;">
                    Verify Code
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Resend Code Cooldown
    const resendLink = document.getElementById('resend-link');
    const resendTimer = document.getElementById('resend-timer');
    const timerSeconds = document.getElementById('timer-seconds');
    
    if (resendLink) {
        resendLink.addEventListener('click', function(e) {
            // Re-enabling logic is handled by page refresh, but we can set a session flag or cookie if we want it to persist.
            // For now, just a simple visual feedback.
        });
    }
});
</script>
{% endblock %}
