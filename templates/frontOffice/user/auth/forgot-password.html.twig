{% extends 'base.html.twig' %}
{% block title %}Forgot Password – UniEarn{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/signup.css') }}">
<style>
    .auth-card { max-width: 480px; }
    .form-subtitle { color: #64748b; margin-bottom: 24px; text-align: center; }
</style>
{% endblock %}

{% block body %}
<div class="auth-layout">
    <div class="auth-left">
        <div class="brand">
            <img src="{{ asset('images/logoUniEarn.png') }}" alt="UniEarn" class="brand-logo">
            <span class="brand-name">UniEarn</span>
        </div>
        <div class="auth-left-body">
            <h2>Forgot Password?</h2>
            <p>Don't worry, it happens to the best of us. Let's get you back into your account.</p>
            <div class="feature-list">
                <div class="feature-item"><div class="feature-dot">🔐</div><span>Secure 2-step verification</span></div>
                <div class="feature-item"><div class="feature-dot">📧</div><span>6-digit code via email</span></div>
                <div class="feature-item"><div class="feature-dot">⏳</div><span>Quick & easy recovery</span></div>
            </div>
        </div>
        <div class="auth-left-footer">© 2025 UniEarn. All rights reserved.</div>
    </div>

    <div class="auth-right">
        <div class="auth-card">
            <div class="auth-card-header">
                <h1>Password Recovery</h1>
                <p>Enter your email to receive a reset code</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-wrap">
                        <div class="flash flash-{{ label }}">{{ label == 'error' ? '✕' : '✓' }} {{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post">
                <div class="field">
                    <label class="field-label">Email Address</label>
                    <input type="email" name="email" class="field-input" placeholder="you@email.com" required>
                </div>

                <button type="submit" class="btn-submit" style="display:block; margin: 24px auto 0;">
                    Send Code <span>→</span>
                </button>
            </form>

            <p class="login-prompt" style="margin-top: 24px;">
                Remembered your password?
                <a href="{{ path('user_login') }}">Sign in</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
