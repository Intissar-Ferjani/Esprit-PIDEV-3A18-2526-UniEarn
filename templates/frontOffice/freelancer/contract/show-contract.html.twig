<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn – Contract Details</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'frontOffice/user/profile/_sidebar.html.twig' with {'active': 'contracts'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">📄 Contract Details</span>
            <div class="top-bar-right">
                <a href="{{ path('freelancer_contract_index') }}" style="color:#9333ea;text-decoration:none;font-size:13px;">← Back to Contracts</a>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <div class="content-section" style="max-width:700px;">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">📄</span>
                        <h3 class="section-title">{{ contract.title }}</h3>
                    </div>
                    {% if contract.status == 'signed' %}
                        <span style="background:#dcfce7;color:#166534;padding:6px 16px;border-radius:20px;font-size:12px;font-weight:600;">✅ Signed</span>
                    {% elseif contract.status == 'pending' %}
                        <span style="background:#fef3c7;color:#92400e;padding:6px 16px;border-radius:20px;font-size:12px;font-weight:600;">⏳ Pending</span>
                    {% else %}
                        <span style="background:#e2e8f0;color:#475569;padding:6px 16px;border-radius:20px;font-size:12px;font-weight:600;">{{ contract.status }}</span>
                    {% endif %}
                </div>
                <hr class="section-divider">

                <div style="display:flex;flex-direction:column;gap:16px;">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                        <div>
                            <span class="field-label">Client</span>
                            <p style="margin:4px 0 0;color:#1e293b;font-weight:600;">{{ contract.client.name }}</p>
                        </div>
                        <div>
                            <span class="field-label">Amount</span>
                            <p style="margin:4px 0 0;color:#1e293b;font-weight:600;">${{ contract.amount }}</p>
                        </div>
                        <div>
                            <span class="field-label">Start Date</span>
                            <p style="margin:4px 0 0;color:#374151;">{{ contract.startDate|date('M d, Y') }}</p>
                        </div>
                        <div>
                            <span class="field-label">End Date</span>
                            <p style="margin:4px 0 0;color:#374151;">{{ contract.endDate|date('M d, Y') }}</p>
                        </div>
                    </div>

                    <div>
                        <span class="field-label">Contract Content</span>
                        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;margin-top:4px;white-space:pre-wrap;font-size:13px;color:#374151;line-height:1.6;">{{ contract.content }}</div>
                    </div>

                    {# ── Signatures ── #}
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px;">
                        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;text-align:center;">
                            <span class="field-label">Client Signature</span>
                            {% if contract.clientSignatureImage %}
                                <img src="{{ contract.clientSignatureImage }}" alt="Client Signature" style="max-width:100%;height:80px;margin-top:8px;border:1px solid #e2e8f0;border-radius:4px;">
                                <p style="color:#166534;font-weight:600;margin:8px 0 0;font-size:12px;">Signed on {{ contract.clientSignature|date('M d, Y H:i') }}</p>
                            {% elseif contract.clientSignature %}
                                <p style="color:#166534;font-weight:600;margin:8px 0 0;">✅ Signed on {{ contract.clientSignature|date('M d, Y H:i') }}</p>
                            {% else %}
                                <p style="color:#94a3b8;margin:8px 0 0;">Not signed yet</p>
                            {% endif %}
                        </div>
                        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;text-align:center;">
                            <span class="field-label">Freelancer Signature</span>
                            {% if contract.freelancerSignatureImage %}
                                <img src="{{ contract.freelancerSignatureImage }}" alt="Freelancer Signature" style="max-width:100%;height:80px;margin-top:8px;border:1px solid #e2e8f0;border-radius:4px;">
                                <p style="color:#166534;font-weight:600;margin:8px 0 0;font-size:12px;">Signed on {{ contract.freelancerSignature|date('M d, Y H:i') }}</p>
                            {% elseif contract.freelancerSignature %}
                                <p style="color:#166534;font-weight:600;margin:8px 0 0;">✅ Signed on {{ contract.freelancerSignature|date('M d, Y H:i') }}</p>
                            {% else %}
                                <p style="color:#94a3b8;margin:8px 0 0;">Not signed yet</p>
                            {% endif %}
                        </div>
                    </div>

                    {# ── Canvas Sign Pad ── #}
                    {% if contract.freelancerSignature is null and contract.status == 'pending' %}
                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:20px;margin-top:8px;">
                        <span class="field-label" style="margin-bottom:10px;display:block;">✍️ Draw Your Signature</span>
                        <canvas id="signatureCanvas" width="600" height="180"
                                style="border:2px solid #cbd5e1;border-radius:8px;background:white;cursor:crosshair;display:block;width:100%;"></canvas>
                        <div style="display:flex;gap:10px;margin-top:12px;">
                            <button type="button" onclick="clearSignature()" class="back-button"
                                    style="padding:8px 20px;font-size:13px;flex:none;cursor:pointer;">🗑️ Clear</button>
                            <form method="post" action="{{ path('freelancer_contract_sign', {id: contract.idContract}) }}" id="signForm" style="flex:1;">
                                <input type="hidden" name="signature" id="signatureData">
                                <button type="submit" class="btn-edit" style="padding:10px 28px;font-size:14px;background:#9333ea;width:100%;">
                                    ✍️ Sign Contract
                                </button>
                            </form>
                        </div>
                    </div>
                    <script>
                    (function() {
                        const canvas = document.getElementById('signatureCanvas');
                        const ctx = canvas.getContext('2d');
                        let drawing = false;
                        let hasDrawn = false;

                        function getPos(e) {
                            const rect = canvas.getBoundingClientRect();
                            const scaleX = canvas.width / rect.width;
                            const scaleY = canvas.height / rect.height;
                            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                            return { x: (clientX - rect.left) * scaleX, y: (clientY - rect.top) * scaleY };
                        }

                        function startDraw(e) { e.preventDefault(); drawing = true; hasDrawn = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }
                        function draw(e) { e.preventDefault(); if (!drawing) return; const p = getPos(e); ctx.lineWidth = 2.5; ctx.lineCap = 'round'; ctx.strokeStyle = '#1e293b'; ctx.lineTo(p.x, p.y); ctx.stroke(); }
                        function stopDraw(e) { e.preventDefault(); drawing = false; }

                        canvas.addEventListener('mousedown', startDraw);
                        canvas.addEventListener('mousemove', draw);
                        canvas.addEventListener('mouseup', stopDraw);
                        canvas.addEventListener('mouseleave', stopDraw);
                        canvas.addEventListener('touchstart', startDraw);
                        canvas.addEventListener('touchmove', draw);
                        canvas.addEventListener('touchend', stopDraw);

                        window.clearSignature = function() { ctx.clearRect(0, 0, canvas.width, canvas.height); hasDrawn = false; };

                        document.getElementById('signForm').addEventListener('submit', function(e) {
                            if (!hasDrawn) { e.preventDefault(); alert('Please draw your signature first.'); return; }
                            if (!confirm('Are you sure you want to sign this contract? This cannot be undone.')) { e.preventDefault(); return; }
                            document.getElementById('signatureData').value = canvas.toDataURL('image/png');
                        });
                    })();
                    </script>
                    {% endif %}

                    {# ── Export PDF ── #}
                    {% if contract.isSigned %}
                    <a href="{{ path('freelancer_contract_pdf', {id: contract.idContract}) }}" class="btn-edit"
                       style="padding:10px 28px;font-size:14px;background:#7c3aed;width:100%;text-align:center;display:block;text-decoration:none;margin-top:8px;"
                       target="_blank">
                        📄 Export as PDF
                    </a>
                    {% endif %}

                    <div style="color:#64748b;font-size:12px;margin-top:8px;">
                        <span>Created: {{ contract.createdAt|date('M d, Y H:i') }}</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
</body>
</html>
