{# templates/frontOffice/freelancer/messaging/messages.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Messages</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ── Messaging layout ── */
        .msg-page { display: flex; height: calc(100vh - 64px); gap: 0; overflow: hidden; }

        /* ── Left panel ── */
        .msg-left {
            width: 320px; min-width: 260px; flex-shrink: 0;
            border-right: 1px solid #e5e7eb;
            display: flex; flex-direction: column; background: #fff;
        }
        .msg-left-header { padding: 16px; border-bottom: 1px solid #e5e7eb; }
        .msg-left-header h2 { margin: 0 0 10px; font-size: 16px; font-weight: 700; color: #111827; }
        .msg-search-form { display: flex; gap: 6px; }
        .msg-search-input {
            flex: 1; padding: 8px 12px; border: 1px solid #e5e7eb;
            border-radius: 8px; font-size: 13px; outline: none;
        }
        .msg-search-input:focus { border-color: #6366f1; }
        .msg-search-btn {
            padding: 8px 12px; background: #6366f1; color: #fff;
            border: none; border-radius: 8px; cursor: pointer; font-size: 13px;
        }
        .msg-search-btn:hover { background: #4f46e5; }

        .msg-freelancer-list { flex: 1; overflow-y: auto; }
        .msg-freelancer-item {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 16px; cursor: pointer; text-decoration: none;
            border-bottom: 1px solid #f3f4f6; transition: background .1s;
            color: inherit;
        }
        .msg-freelancer-item:hover { background: #f9fafb; }
        .msg-freelancer-item.active { background: #eff0ff; border-left: 3px solid #6366f1; }

        .msg-avatar-wrap { position: relative; flex-shrink: 0; }
        .msg-avatar {
            width: 42px; height: 42px; border-radius: 50%;
            background: #6366f1; color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 16px; overflow: hidden;
        }
        .msg-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .msg-online-dot {
            position: absolute; bottom: 1px; right: 1px;
            width: 11px; height: 11px; border-radius: 50%;
            background: #22c55e; border: 2px solid #fff;
        }
        .msg-freelancer-info { flex: 1; min-width: 0; }
        .msg-freelancer-name {
            font-size: 14px; font-weight: 600; color: #111827;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .msg-last-msg {
            font-size: 12px; color: #9ca3af;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            margin-top: 2px;
        }
        .msg-unread-badge {
            background: #6366f1; color: #fff; border-radius: 12px;
            padding: 2px 7px; font-size: 11px; font-weight: 700; flex-shrink: 0;
        }

        /* ── Right panel ── */
        .msg-right {
            flex: 1; display: flex; flex-direction: column; background: #f9fafb; overflow: hidden;
        }
        .msg-empty-state {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: center; color: #9ca3af;
        }
        .msg-empty-state .msg-empty-icon { font-size: 48px; margin-bottom: 12px; }
        .msg-empty-state p { font-size: 15px; font-weight: 500; }

        /* ── Chat header ── */
        .msg-chat-header {
            padding: 14px 20px; background: #fff;
            border-bottom: 1px solid #e5e7eb;
            display: flex; align-items: center; gap: 12px; flex-shrink: 0;
        }
        .msg-chat-partner-name { font-size: 15px; font-weight: 700; color: #111827; }
        .msg-chat-partner-status { font-size: 12px; color: #9ca3af; margin-top: 1px; }
        .msg-chat-partner-status.online { color: #22c55e; }

        /* ── Messages area ── */
        .msg-messages-area {
            flex: 1; overflow-y: auto; padding: 20px;
            display: flex; flex-direction: column; gap: 10px;
        }
        .msg-bubble-wrap { display: flex; align-items: flex-end; gap: 8px; }
        .msg-bubble-wrap.mine { flex-direction: row-reverse; }
        .msg-bubble {
            max-width: 65%; padding: 10px 14px; border-radius: 16px;
            font-size: 14px; line-height: 1.4; word-break: break-word;
        }
        .msg-bubble.theirs {
            background: #fff; color: #111827;
            border-bottom-left-radius: 4px; box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }
        .msg-bubble.mine {
            background: #6366f1; color: #fff; border-bottom-right-radius: 4px;
        }
        .msg-time {
            font-size: 11px; color: #9ca3af; margin-top: 4px;
            text-align: right; flex-shrink: 0; padding-bottom: 2px;
        }
        .msg-bubble-wrap.mine .msg-time { text-align: left; }

        /* ── Input ── */
        .msg-input-area {
            padding: 14px 20px; background: #fff;
            border-top: 1px solid #e5e7eb; flex-shrink: 0;
        }
        .msg-input-row { display: flex; gap: 10px; align-items: center; }
        .msg-input {
            flex: 1; padding: 10px 16px; border: 1px solid #e5e7eb;
            border-radius: 24px; font-size: 14px; outline: none; resize: none;
            font-family: inherit;
        }
        .msg-input:focus { border-color: #6366f1; }
        .msg-send-btn {
            width: 42px; height: 42px; border-radius: 50%;
            background: #6366f1; color: #fff; border: none; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; transition: background .15s; flex-shrink: 0;
        }
        .msg-send-btn:hover { background: #4f46e5; }

        /* ── Notification bell ── */
        .notif-bell-wrap {
            position: relative; cursor: pointer; display: inline-flex;
            align-items: center; justify-content: center;
            width: 38px; height: 38px; border-radius: 50%;
            background: #f3f4f6; transition: background .15s;
        }
        .notif-bell-wrap:hover { background: #e5e7eb; }
        .notif-badge {
            position: absolute; top: 2px; right: 2px;
            background: #ef4444; color: #fff; border-radius: 50%;
            width: 17px; height: 17px; font-size: 10px; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid #fff; display: none;
        }
        .notif-dropdown {
            position: absolute; top: 44px; right: 0;
            width: 320px; background: #fff; border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,.15); z-index: 500;
            display: none; flex-direction: column; overflow: hidden;
        }
        .notif-dropdown.open { display: flex; }
        .notif-dd-header {
            padding: 12px 16px; border-bottom: 1px solid #f3f4f6;
            font-size: 14px; font-weight: 600; color: #111827;
            display: flex; justify-content: space-between; align-items: center;
        }
        .notif-mark-all { font-size: 12px; color: #6366f1; cursor: pointer; font-weight: 500; }
        .notif-mark-all:hover { text-decoration: underline; }
        .notif-list { max-height: 320px; overflow-y: auto; }
        .notif-item {
            padding: 12px 16px; border-bottom: 1px solid #f9fafb;
            display: flex; gap: 10px; align-items: flex-start;
            cursor: pointer; text-decoration: none; color: inherit;
        }
        .notif-item:hover { background: #f9fafb; }
        .notif-icon { font-size: 18px; flex-shrink: 0; }
        .notif-text { font-size: 13px; color: #374151; line-height: 1.4; }
        .notif-time { font-size: 11px; color: #9ca3af; margin-top: 3px; }
        .notif-empty { padding: 20px; text-align: center; color: #9ca3af; font-size: 13px; }
    </style>
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'frontOffice/freelancer/profile/_sidebar.html.twig' with {'active': 'messages'} %}

    <div class="dashboard-main">

        {# ── Top Bar ── #}
        <div class="top-bar">
            <span class="top-bar-title">💬 Messages</span>
            <div class="top-bar-right" style="display:flex;align-items:center;gap:12px;">

                {# ── Notification Bell ── #}
                <div class="notif-bell-wrap" id="notifBell" onclick="toggleNotifDropdown()">
                    🔔
                    <span class="notif-badge" id="notifBadge"></span>
                    <div class="notif-dropdown" id="notifDropdown">
                        <div class="notif-dd-header">
                            Notifications
                            <span class="notif-mark-all" onclick="markAllRead(event)">Mark all read</span>
                        </div>
                        <div class="notif-list" id="notifList">
                            <div class="notif-empty">Loading…</div>
                        </div>
                    </div>
                </div>

                <span class="top-bar-user">👤 {{ user.name }}</span>
            </div>
        </div>

        <div class="dashboard-content" style="padding:0;overflow:hidden;">
            <div class="msg-page">

                {# ══ LEFT – freelancer list ══ #}
                <div class="msg-left">
                    <div class="msg-left-header">
                        <h2>Conversations</h2>
                        <form class="msg-search-form" method="GET" action="{{ path('freelancer_messages') }}">
                            <input type="text" name="q" class="msg-search-input"
                                   placeholder="Search freelancers…" value="{{ search }}">
                            <button type="submit" class="msg-search-btn">🔍</button>
                        </form>
                    </div>

                    <div class="msg-freelancer-list">
                        {% for item in freelancers %}
                            {% set isActive = activeChat and chatPartner and chatPartner.idFreelancer == item.freelancer.idFreelancer %}
                            <a href="{{ path('freelancer_messages_open', {freelancerId: item.freelancer.idFreelancer}) }}"
                               class="msg-freelancer-item {{ isActive ? 'active' : '' }}">
                                <div class="msg-avatar-wrap">
                                    <div class="msg-avatar">
                                        {% if item.user.profilePicturePath %}
                                            <img src="{{ asset(item.user.profilePicturePath) }}" alt="avatar">
                                        {% else %}
                                            {{ item.user.name|first|upper }}
                                        {% endif %}
                                    </div>
                                    {% if item.online %}
                                        <span class="msg-online-dot" title="Online"></span>
                                    {% endif %}
                                </div>
                                <div class="msg-freelancer-info">
                                    <div class="msg-freelancer-name">{{ item.user.name }}</div>
                                    <div class="msg-last-msg">
                                        {% if item.lastMsg %}
                                            {{ item.lastMsg.content|slice(0,35) }}{% if item.lastMsg.content|length > 35 %}…{% endif %}
                                        {% else %}
                                            No messages yet
                                        {% endif %}
                                    </div>
                                </div>
                                {% if item.unread > 0 %}
                                    <span class="msg-unread-badge">{{ item.unread }}</span>
                                {% endif %}
                            </a>
                        {% else %}
                            <div style="padding:24px;text-align:center;color:#9ca3af;font-size:13px;">
                                No freelancers found.
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# ══ RIGHT – conversation ══ #}
                <div class="msg-right">
                    {% if activeChat and chatPartner %}

                        {# Chat header #}
                        <div class="msg-chat-header">
                            <div class="msg-avatar-wrap">
                                <div class="msg-avatar" style="width:38px;height:38px;font-size:14px;">
                                    {% if chatPartner.user.profilePicturePath %}
                                        <img src="{{ asset(chatPartner.user.profilePicturePath) }}" alt="avatar">
                                    {% else %}
                                        {{ chatPartner.user.name|first|upper }}
                                    {% endif %}
                                </div>
                                {% if chatPartner.user.isOnline %}
                                    <span class="msg-online-dot"></span>
                                {% endif %}
                            </div>
                            <div>
                                <div class="msg-chat-partner-name">{{ chatPartner.user.name }}</div>
                                <div class="msg-chat-partner-status {{ chatPartner.user.isOnline ? 'online' : '' }}">
                                    {{ chatPartner.user.isOnline ? '● Online' : 'Offline' }}
                                </div>
                            </div>
                        </div>

                        {# Messages bubble area #}
                        <div class="msg-messages-area" id="msgArea">
                            {% for msg in messages %}
                                {% set isMine = msg.senderId == app.session.get('user_id') %}
                                <div class="msg-bubble-wrap {{ isMine ? 'mine' : '' }}">
                                    <div class="msg-bubble {{ isMine ? 'mine' : 'theirs' }}">
                                        {{ msg.content }}
                                    </div>
                                    <div class="msg-time">{{ msg.sentDate|date('H:i') }}</div>
                                </div>
                            {% else %}
                                <div style="text-align:center;color:#9ca3af;font-size:13px;margin-top:40px;">
                                    No messages yet. Say hello! 👋
                                </div>
                            {% endfor %}
                        </div>

                        {# Message input #}
                        <div class="msg-input-area">
                            <div class="msg-input-row">
                                <textarea class="msg-input" id="msgInput" rows="1"
                                          placeholder="Type a message…"></textarea>
                                <button class="msg-send-btn" onclick="sendMessage()">➤</button>
                            </div>
                        </div>

                    {% else %}
                        <div class="msg-empty-state">
                            <div class="msg-empty-icon">💬</div>
                            <p>Select a freelancer to start chatting</p>
                        </div>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>
</div>

{% include 'frontOffice/components/_chatbot.html.twig' %}
<script src="{{ asset('js/chatbot.js') }}"></script>

<script>
{% if activeChat %}
const CHAT_ID  = {{ activeChat.idChat }};
const MY_ID    = {{ app.session.get('user_id') }};
let   lastId   = {{ messages|length > 0 ? messages|last.idMessage : 0 }};

// ── Auto-scroll to bottom ──
function scrollBottom() {
    const area = document.getElementById('msgArea');
    if (area) area.scrollTop = area.scrollHeight;
}
scrollBottom();

// ── Append a bubble ──
function appendBubble(msg) {
    const area   = document.getElementById('msgArea');
    const isMine = msg.senderId == MY_ID;
    const wrap   = document.createElement('div');
    wrap.className = 'msg-bubble-wrap' + (isMine ? ' mine' : '');
    wrap.innerHTML = `
        <div class="msg-bubble ${isMine ? 'mine' : 'theirs'}">${escHtml(msg.content)}</div>
        <div class="msg-time">${msg.sentDate}</div>`;
    area.appendChild(wrap);
    scrollBottom();
    if (msg.id > lastId) lastId = msg.id;
}

function escHtml(t) {
    return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ── Send ──
async function sendMessage() {
    const input   = document.getElementById('msgInput');
    const content = input.value.trim();
    if (!content) return;
    input.value = '';
    input.style.height = 'auto';

    const fd = new FormData();
    fd.append('content', content);

    try {
        const res  = await fetch('{{ path('freelancer_messages_send', {chatId: activeChat.idChat}) }}', {
            method: 'POST', body: fd
        });
        const data = await res.json();
        if (data.id) appendBubble(data);
    } catch { /* ignore */ }
}

// ── Poll for new messages every 2 s ──
setInterval(async () => {
    try {
        const res  = await fetch(`/freelancer/messages/${CHAT_ID}/poll?after=${lastId}`);
        const data = await res.json();
        (data.messages || []).forEach(appendBubble);
    } catch { /* ignore */ }
}, 2000);

// ── Send on Enter (Shift+Enter = newline) ──
document.getElementById('msgInput')?.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
});

// ── Auto-resize textarea ──
document.getElementById('msgInput')?.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
});
{% endif %}

// ════════════════════════════════════════════════════════
// NOTIFICATION BELL
// ════════════════════════════════════════════════════════
const NOTIF_ICONS = { LIKE:'👍', DISLIKE:'👎', COMMENT:'💬', MESSAGE:'✉️' };

async function loadNotifications() {
    try {
        const res  = await fetch('{{ path('freelancer_notifications_list') }}');
        const data = await res.json();
        const badge = document.getElementById('notifBadge');
        const list  = document.getElementById('notifList');

        if (data.unread > 0) {
            badge.style.display = 'flex';
            badge.textContent   = data.unread > 9 ? '9+' : data.unread;
        } else {
            badge.style.display = 'none';
        }

        if (!data.notifications.length) {
            list.innerHTML = '<div class="notif-empty">No new notifications</div>';
            return;
        }
        list.innerHTML = data.notifications.map(n => `
            <a class="notif-item" href="${n.link || '#'}">
                <span class="notif-icon">${NOTIF_ICONS[n.type] || '🔔'}</span>
                <div>
                    <div class="notif-text">${escHtmlNotif(n.content)}</div>
                    <div class="notif-time">${n.createdAt}</div>
                </div>
            </a>`).join('');
    } catch { /* ignore */ }
}

function escHtmlNotif(t) {
    return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function toggleNotifDropdown() {
    const dd = document.getElementById('notifDropdown');
    dd.classList.toggle('open');
    if (dd.classList.contains('open')) loadNotifications();
}

async function markAllRead(e) {
    e.stopPropagation();
    await fetch('{{ path('freelancer_notifications_mark_read') }}', { method: 'POST' });
    loadNotifications();
}

// Close on outside click
document.addEventListener('click', function(e) {
    const bell = document.getElementById('notifBell');
    if (bell && !bell.contains(e.target)) {
        document.getElementById('notifDropdown')?.classList.remove('open');
    }
});

// Poll badge every 15 s
loadNotifications();
setInterval(loadNotifications, 15000);
</script>
</body>
</html>
