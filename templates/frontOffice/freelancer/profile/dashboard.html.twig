<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – {{ user.name }}'s Profile</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    
    {# ── Face-API Library & AI Styles ── #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <style>
        .ai-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            margin-top: 12px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #64748b;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        .ai-status-badge.ai-loading { background: #eff6ff; color: #2563eb; border-color: #bfdbfe; }
        .ai-status-badge.ai-success { background: #f0fdf4; color: #16a34a; border-color: #bbf7d0; }
        .ai-status-badge.ai-error   { background: #fef2f2; color: #ef4444; border-color: #fecaca; }
        
        .ai-pulse {
            width: 7px; height: 7px; border-radius: 50%; background: currentColor;
            animation: ai-pulse-anim 1.5s infinite;
        }
        @keyframes ai-pulse-anim {
            0% { transform: scale(0.9); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.5; }
            100% { transform: scale(0.9); opacity: 1; }
        }
    </style>
</head>
<body class="dashboard-body">

<div class="dashboard-layout">

    {# Sidebar — client sees client sidebar, freelancer sees freelancer sidebar #}
    {% set sidebar = sidebarInclude ?? 'frontOffice/user/profile/_sidebar.html.twig' %}
    {% set active  = sidebarActive  ?? 'dashboard' %}
    {% include sidebar with {'active': active} %}

    <div class="dashboard-main">

        <div class="top-bar">
            {# Back link when client/admin is visiting #}
            {% if viewerRole in ['CLIENT', 'ADMIN'] and backUrl %}
                <div style="display:flex;align-items:center;gap:12px;">
                    <a href="{{ backUrl }}" style="color:#2563EB;text-decoration:none;font-size:13px;font-weight:600;">
                        ← Back to Freelancers
                    </a>
                    <span style="color:#cbd5e0;">|</span>
                    <span class="top-bar-title">{{ user.name }}'s Profile</span>
                </div>
            {% else %}
                <span class="top-bar-title">Dashboard</span>
            {% endif %}

            <div class="top-bar-right">
                <span class="top-bar-user" style="margin-top: 10px;">👤 {{ user.name }}</span>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {# ── Profile Header Card ── #}
            <div class="profile-header-card">
                <div class="profile-banner"></div>
                <div class="profile-header-body">

                    {# Avatar — editable only for the freelancer themselves #}
                    <div class="avatar-wrap">
                        {% if viewerRole == 'FREELANCER' %}
                            <form method="post" action="{{ path('freelancer_change_photo') }}"
                                  enctype="multipart/form-data" id="photoForm">
                                <label for="photoInput" class="avatar-label" title="Change photo">
                                    {% if user.profilePicturePath %}
                                        <img src="{{ asset(user.profilePicturePath) }}" class="profile-avatar" alt="Avatar">
                                    {% else %}
                                        <img src="{{ asset('images/default-avatar.jpg') }}" class="profile-avatar" alt="Avatar">
                                    {% endif %}
                                    <span class="avatar-camera">📷</span>
                                </label>
                                <input type="file" id="photoInput" name="profile_photo" accept="image/*"
                                       style="display:none" onchange="handleDashboardPhotoChange(event)">
                                <div id="ai-status" class="ai-status-badge" style="display:none; position:absolute; bottom:-45px; left:50%; transform:translateX(-50%); white-space:nowrap; z-index:10;">
                                    <div class="ai-pulse"></div>
                                    <span id="ai-status-text">Scanning...</span>
                                </div>
                            </form>
                        {% else %}
                            {# Client view — avatar is read-only, no camera icon #}
                            {% if user.profilePicturePath %}
                                <img src="{{ asset(user.profilePicturePath) }}" class="profile-avatar" alt="{{ user.name }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.jpg') }}" class="profile-avatar" alt="{{ user.name }}">
                            {% endif %}
                        {% endif %}
                    </div>

                    {# Info #}
                    <div class="profile-info">
                        <h2 class="profile-name">{{ user.name }}</h2>
                        <p class="profile-email">{{ user.email }}</p>
                        <div class="profile-pills">
                            <span class="pill pill-blue">💰 {{ freelancer.pricePerHour }} TND/hr</span>
                            <span class="pill pill-orange">⭐ {{ freelancer.rating }}</span>
                            {% if freelancer.verificationStatus == 'verified' %}
                                <span class="pill pill-green">✅ Verified</span>
                            {% else %}
                                <span class="pill" style="background:#fef3c7;color:#b45309;">⏳ Not Verified</span>
                            {% endif %}
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;">
                            {% for skill in freelancer.skillsArray %}
                                <span class="pill pill-blue" style="font-size:11px;">{{ skill }}</span>
                            {% endfor %}
                        </div>
                    </div>

                    {# Edit button — only for the freelancer themselves #}
                    {% if viewerRole == 'FREELANCER' %}
                    <div class="profile-edit-btn-wrap">
                        <a href="{{ path('freelancer_profile_edit') }}" class="btn-edit">✏️ Edit Profile</a>
                    </div>
                    {% endif %}

                    {# Admin actions — shown when admin is viewing #}
                    {% if viewerRole == 'ADMIN' %}
                    <div class="profile-edit-btn-wrap" style="display:flex;gap:8px;flex-direction:column;align-items:flex-end;">
                        <form method="post" action="{{ path('admin_toggle_user', {id: user.idUser}) }}">
                            <button type="submit" class="btn-edit"
                                    style="background:{{ user.isActivated ? '#f59e0b' : '#16a34a' }};">
                                {{ user.isActivated ? '🚫 Deactivate' : '✅ Activate' }}
                            </button>
                        </form>
                        <form method="post" action="{{ path('admin_delete_user', {id: user.idUser}) }}"
                            onsubmit="return confirm('Delete this user permanently?')">
                            <button type="submit" class="btn-edit" style="background:#ef4444;">🗑 Delete</button>
                        </form>
                    </div>
                    {% endif %}

                </div>
            </div>

            {# ── About Me ── #}
            <div class="content-section" style="margin-top:20px;">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">👤</span>
                        <h3 class="section-title">About Me</h3>
                    </div>
                </div>
                <hr class="section-divider">
                <p style="color:#374151;font-size:14px;line-height:1.7;">
                    {{ freelancer.bio ?: 'No bio available.' }}
                </p>
            </div>

            {# ── Admin extra details ── #}
            {% if viewerRole == 'ADMIN' %}
            <div class="content-section" style="margin-top:20px;">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">📊</span>
                        <h3 class="section-title">Freelancer Details</h3>
                    </div>
                </div>
                <hr class="section-divider">
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
                    <div>
                        <p class="field-label">Price/Hour</p>
                        <p style="font-weight:600;color:#1e293b;">{{ freelancer.pricePerHour }} TND</p>
                    </div>
                    <div>
                        <p class="field-label">Rating</p>
                        <p style="font-weight:600;color:#1e293b;">⭐ {{ freelancer.rating }}</p>
                    </div>
                    <div>
                        <p class="field-label">Total Earned</p>
                        <p style="font-weight:600;color:#1e293b;">{{ freelancer.amount }} TND</p>
                    </div>
                    <div>
                        <p class="field-label">Verification</p>
                        <p style="font-weight:600;color:#1e293b;">{{ freelancer.verificationStatus }}</p>
                    </div>
                    <div>
                        <p class="field-label">Availability</p>
                        <p style="font-weight:600;color:#1e293b;">{{ freelancer.status }}</p>
                    </div>
                    <div>
                        <p class="field-label">Account Status</p>
                        <p style="font-weight:600;color:{{ user.isActivated ? '#16a34a' : '#dc2626' }};">
                            {{ user.isActivated ? '✅ Active' : '🚫 Deactivated' }}
                        </p>
                    </div>
                </div>
            </div>
            {% endif %}

            {# ── Portfolio ── #}
            <div class="content-section" style="margin-top:20px;">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <span class="section-icon">💼</span>
                        <h3 class="section-title">Portfolio</h3>
                    </div>
                    {% if portfolio %}
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="color:#64748b;font-size:13px;">{{ items|length }} project{{ items|length != 1 ? 's' : '' }}</span>
                            {# Manage button — only for the freelancer #}
                            {% if viewerRole == 'FREELANCER' %}
                                <a href="{{ path('freelancer_portfolio_page') }}" class="btn-edit" style="font-size:12px;padding:6px 14px;">
                                    Manage Portfolio →
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
                <hr class="section-divider">

                {% if not portfolio %}
                    {# No portfolio yet #}
                    <div style="text-align:center;padding:30px 0;">
                        <div style="font-size:40px;margin-bottom:10px;">💼</div>
                        <p style="font-weight:700;font-size:16px;color:#1e293b;margin-bottom:6px;">
                            {% if viewerRole == 'FREELANCER' %}Showcase Your Work{% else %}No Portfolio Yet{% endif %}
                        </p>
                        <p style="color:#718096;font-size:13px;margin-bottom:16px;">
                            {% if viewerRole == 'FREELANCER' %}Build your portfolio to attract more clients{% else %}This freelancer hasn't added a portfolio yet{% endif %}
                        </p>
                        {% if viewerRole == 'FREELANCER' %}
                            <a href="{{ path('freelancer_portfolio_page') }}" class="btn-edit">Create Portfolio →</a>
                        {% endif %}
                    </div>

                {% elseif items is empty %}
                    <div class="empty-state" style="padding:24px 0;">
                        <span class="empty-icon" style="font-size:36px;">💼</span>
                        <p class="empty-text">Portfolio exists but no projects added yet</p>
                        {% if viewerRole == 'FREELANCER' %}
                            <a href="{{ path('freelancer_portfolio_page') }}" class="btn-edit" style="margin-top:12px;display:inline-block;">Add Projects →</a>
                        {% endif %}
                    </div>

                {% else %}
                    {# Portfolio items #}
                    {% for item in items %}
                    <div class="portfolio-item-card">
                        <div class="item-accent"></div>
                        <div class="item-body">
                            <div class="item-header">
                                <div class="item-icon">💻</div>
                                <span class="item-title">{{ item.title }}</span>
                            </div>
                            <p class="item-desc">{{ item.description }}</p>
                            {% if item.technologiesArray is not empty %}
                            <div class="tech-wrap">
                                {% for tech in item.technologiesArray %}
                                    <span class="tech-badge">{{ tech }}</span>
                                {% endfor %}
                            </div>
                            {% endif %}
                            {% if item.projectUrl or item.githubUrl %}
                            <div class="item-links">
                                {% if item.projectUrl %}
                                    <a href="{{ item.projectUrl }}" target="_blank" class="link-chip link-chip-blue">🔗 View Project</a>
                                {% endif %}
                                {% if item.githubUrl %}
                                    <a href="{{ item.githubUrl }}" target="_blank" class="link-chip link-chip-dark">🐙 GitHub</a>
                                {% endif %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}

            </div>

        </div>
    </div>
</div>

<script>
    const MODEL_URL = 'https://raw.githubusercontent.com/justadudewhohacks/face-api.js/master/weights/';
    let modelsLoaded = false;

    async function loadAIModels() {
        if (modelsLoaded) return;
        try {
            await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
            modelsLoaded = true;
        } catch (e) {
            console.error("AI Model error:", e);
        }
    }

    window.handleDashboardPhotoChange = async function(e) {
        const file = e.target.files[0];
        const statusBadge = document.getElementById('ai-status');
        const statusText  = document.getElementById('ai-status-text');
        const preview     = document.querySelector('.profile-avatar');
        const form        = document.getElementById('photoForm');

        if (!file) return;

        // 1. Show preview instantly
        const reader = new FileReader();
        reader.onload = evt => { preview.src = evt.target.result; };
        reader.readAsDataURL(file);

        // 2. AI Scan
        statusBadge.style.display = 'inline-flex';
        statusBadge.className = 'ai-status-badge ai-loading';
        statusText.textContent = 'AI Scanning...';

        await loadAIModels();

        // Small delay for image processing
        setTimeout(async () => {
            const detections = await faceapi.detectSingleFace(preview, new faceapi.TinyFaceDetectorOptions());

            if (detections) {
                statusBadge.className = 'ai-status-badge ai-success';
                statusText.textContent = 'Face detected! Saving...';
                setTimeout(() => form.submit(), 800);
            } else {
                statusBadge.className = 'ai-status-badge ai-error';
                statusText.textContent = 'No face detected ❌';
                e.target.value = '';
                setTimeout(() => { statusBadge.style.display = 'none'; }, 3000);
            }
        }, 600);
    };
</script>
</body>
</html>
