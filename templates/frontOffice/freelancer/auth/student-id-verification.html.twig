<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Student Verification</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/signup.css') }}">
    <style>
        .step-connector { flex:1; height:2px; background:#20C997; margin:0 8px 18px; }
        .step-connector-inactive { flex:1; height:2px; background:#e2e8f0; margin:0 8px 18px; }
        .progress-wrap { display:flex; align-items:center; margin-bottom:32px; }
        .step-box { display:flex; flex-direction:column; align-items:center; gap:6px; }
        .step-circle { width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Plus Jakarta Sans',sans-serif; font-weight:700; font-size:14px; }
        .step-completed { background:#20C997; color:white; }
        .step-active    { background:#2563EB; color:white; }
        .step-inactive  { background:#e2e8f0; color:#a0aec0; }
        .step-label { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.4px; }
        .label-completed { color:#20C997; }
        .label-active    { color:#2563EB; }
        .label-inactive  { color:#a0aec0; }
        .btn-row { display:flex; gap:12px; margin-top:8px; }
        .back-button {
            flex:1; padding:14px;
            background:transparent; border:1.5px solid #2563EB; border-radius:12px;
            color:#2563EB; font-family:'Plus Jakarta Sans',sans-serif; font-size:15px; font-weight:700;
            cursor:pointer; text-align:center; text-decoration:none;
            display:flex; align-items:center; justify-content:center; transition:background .2s;
        }
        .back-button:hover { background:#eff6ff; }
        .info-box {
            background:#fefce8; border:1.5px solid #fde047;
            border-radius:12px; padding:16px 20px; margin-bottom:24px;
        }
        .info-box p { color:#78350f; font-size:13px; margin:0; line-height:1.6; }
        .verify-box {
            background:#f0f9ff; border:1.5px solid #bfdbfe;
            border-radius:12px; padding:20px; margin-bottom:8px;
        }
        .verify-box h3 { font-family:'Plus Jakarta Sans',sans-serif; font-size:15px; font-weight:700; color:#1e40af; margin-bottom:12px; }
        .requirement { display:flex; align-items:center; gap:8px; font-size:13px; color:#1e40af; padding:3px 0; }
        .requirement::before { content:'✓'; font-weight:700; color:#20C997; }
        .upload-area {
            margin-top:16px; padding-top:16px;
            border-top:1px solid #bfdbfe;
        }
    </style>
</head>
<body>
<div class="auth-layout">

    <div class="auth-left">
        <div class="brand">
            <img src="{{ asset('images/logoUniEarn.png') }}" alt="UniEarn" class="brand-logo">
            <span class="brand-name">UniEarn</span>
        </div>
        <div class="auth-left-body">
            <h2>Verify your student status</h2>
            <p>UniEarn is exclusively for students. We verify all freelancers to maintain platform integrity.</p>
            <div class="feature-list">
                <div class="feature-item"><div class="feature-dot">🔒</div><span>Safe & secure verification</span></div>
                <div class="feature-item"><div class="feature-dot">🎓</div><span>Students-only platform</span></div>
                <div class="feature-item"><div class="feature-dot">✓</div><span>Builds trust with clients</span></div>
                <div class="feature-item"><div class="feature-dot">⚡</div><span>Quick review process</span></div>
            </div>
        </div>
        <div class="auth-left-footer">© 2025 UniEarn. All rights reserved.</div>
    </div>

    <div class="auth-right">
        <div class="auth-card">

            <div class="progress-wrap">
                <div class="step-box">
                    <div class="step-circle step-completed">✓</div>
                    <span class="step-label label-completed">Account</span>
                </div>
                <div class="step-connector"></div>
                <div class="step-box">
                    <div class="step-circle step-completed">✓</div>
                    <span class="step-label label-completed">Profile</span>
                </div>
                <div class="step-connector"></div>
                <div class="step-box">
                    <div class="step-circle step-active">3</div>
                    <span class="step-label label-active">Verify</span>
                </div>
                <div class="step-connector-inactive"></div>
                <div class="step-box">
                    <div class="step-circle step-inactive">4</div>
                    <span class="step-label label-inactive">Portfolio</span>
                </div>
            </div>

            <div class="auth-card-header">
                <h1>Student Verification</h1>
                <p>Prove you're a student to unlock freelancing</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-wrap">
                        <div class="flash flash-{{ label }}">{{ label == 'error' ? '✕' : '✓' }} {{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="info-box">
                <p><strong>Why do we need this?</strong><br>
                UniEarn is exclusively for student freelancers. We verify all accounts to maintain platform integrity and protect clients.</p>
            </div>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}, 'action': path('freelancer_verify')}) }}

                <div class="verify-box">
                    <h3>🎓 Upload Student Card</h3>
                    <div class="requirement">Clear photo or scan of your student card</div>
                    <div class="requirement">Card must be valid for current academic year</div>
                    <div class="requirement">All text must be readable</div>
                    <div class="requirement">Accepted formats: JPG, PNG, PDF (max 5MB)</div>
                    <div class="upload-area field">
                        <div style="display: none;">{{ form_label(form.studentCardFile) }}</div>
                        <div class="upload-action" style="margin-top: 10px;">
                            {{ form_widget(form.studentCardFile, {'attr': {'accept': 'image/*,.pdf', 'class': 'cv-input'}}) }}
                            
                            <button type="button" class="upload-btn">
                                Select file
                            </button>

                            <span class="file-chip hidden">
                                <span class="file-name"></span>
                                <span class="remove-file">✕</span>
                            </span>
                        </div>
                        <div id="verification-status" class="verification-status hidden" style="margin-top: 15px; padding: 12px; border-radius: 8px; font-size: 13px; font-weight: 600;"></div>
                        <div class="field-errors">{{ form_errors(form.studentCardFile) }}</div>
                    </div>
                </div>

                <div class="btn-row">
                    <a href="{{ path('freelancer_setup') }}" class="back-button">← Back</a>
                    <button type="submit" id="next-btn" class="btn-submit" style="flex:1.5; margin-top:0;" disabled>Next →</button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
<script>
const fileInput = document.querySelector('.cv-input');
const uploadBtn = document.querySelector('.upload-btn');
const fileChip = document.querySelector('.file-chip');
const fileName = document.querySelector('.file-name');
const removeBtn = document.querySelector('.remove-file');
const statusDiv = document.querySelector('#verification-status');
const nextBtn   = document.querySelector('#next-btn');

// Initialize state from session (Restoration)
window.addEventListener('DOMContentLoaded', () => {
    const savedPath = "{{ app.session.get('card_path')|default('') }}";
    const isVerified = "{{ app.session.get('card_verified')|default(false) ? '1' : '0' }}" === '1';

    if (savedPath) {
        const basename = savedPath.split('/').pop();
        fileName.textContent = basename;
        fileChip.classList.remove('hidden');
        
        statusDiv.textContent = isVerified 
           ? " Previously verified card restored." 
           : "⚠️ Card found but needs verification.";
        statusDiv.style.background = isVerified ? "#f0fdf4" : "#fffbeb";
        statusDiv.style.color = isVerified ? "#16a34a" : "#92400e";
        statusDiv.style.border = isVerified ? "1.5px solid #bbf7d0" : "1.5px solid #fde68a";
        statusDiv.classList.remove('hidden');
        
        if (isVerified) {
            nextBtn.disabled = false;
        }
    }
});

uploadBtn.addEventListener('click', () => fileInput.click());

fileInput.addEventListener('change', async () => {
    if (fileInput.files.length > 0) {
        const file = fileInput.files[0];
        fileName.textContent = file.name;
        fileChip.classList.remove('hidden');

        // Start OCR process
        statusDiv.textContent = "🔍 Analyzing your student card, please wait...";
        statusDiv.style.background = "#eff6ff";
        statusDiv.style.color = "#2563EB";
        statusDiv.style.border = "1.5px solid #bfdbfe";
        statusDiv.classList.remove('hidden');
        
        uploadBtn.disabled = true;
        nextBtn.disabled = true;

        const formData = new FormData();
        formData.append('studentCardFile', file);

        try {
            const response = await fetch("{{ path('freelancer_verify_card_process') }}", {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            
            statusDiv.textContent = (result.success ? " " : "❌ ") + result.message;
            
            if (result.success) {
                statusDiv.style.background = "#f0fdf4";
                statusDiv.style.color = "#16a34a";
                statusDiv.style.border = "1.5px solid #bbf7d0";
                nextBtn.disabled = false;
            } else {
                statusDiv.style.background = "#fef2f2";
                statusDiv.style.color = "#dc2626";
                statusDiv.style.border = "1.5px solid #fecaca";
                nextBtn.disabled = true;
            }
        } catch (error) {
            console.error("Verification Error:", error);
            statusDiv.textContent = "❌ An error occurred during verification. Please try again.";
            statusDiv.style.background = "#fef2f2";
            statusDiv.style.color = "#dc2626";
            statusDiv.style.border = "1.5px solid #fecaca";
        } finally {
            uploadBtn.disabled = false;
        }
    }
});

removeBtn.addEventListener('click', () => {
    fileInput.value = '';
    fileChip.classList.add('hidden');
    statusDiv.classList.add('hidden');
    nextBtn.disabled = true;
});
</script>
</body>
</html>