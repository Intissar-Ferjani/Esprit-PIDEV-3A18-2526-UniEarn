<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Student Verification</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <style>
        .progress-wrap { display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:20px; }
        .step-box { display:flex; flex-direction:column; align-items:center; gap:5px; }
        .step-circle { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; }
        .step-completed { background:#20C997; color:white; }
        .step-active    { background:#2563EB; color:white; }
        .step-inactive  { background:#e2e8f0; color:#a0aec0; }
        .step-label { font-size:10px; }
        .label-completed { color:#20C997; } .label-active { color:#2563EB; } .label-inactive { color:#a0aec0; }
        .step-line { font-size:14px; font-weight:700; color:#20C997; margin-bottom:18px; }
        .step-line-inactive { font-size:14px; font-weight:700; color:#cbd5e0; margin-bottom:18px; }

        .info-box { background:#fef3c7; border:2px solid #fcd34d; border-radius:8px; padding:15px; margin-bottom:20px; }
        .info-box p { color:#78350f; font-size:13px; margin:0; }
        .info-box strong { color:#92400e; }

        .verify-box { background:#f0f9ff; border:2px solid #bfdbfe; border-radius:10px; padding:20px; }
        .requirement { color:#1e40af; font-size:12px; padding:3px 0 3px 15px; display:block; }

        .btn-row { display:flex; gap:15px; margin-top:20px; }
        .back-button { flex:1; height:42px; background:transparent; border:2px solid #2563EB; border-radius:8px; color:#2563EB; font-size:14px; font-weight:700; cursor:pointer; text-decoration:none; display:flex; align-items:center; justify-content:center; }
        .next-button { flex:1.5; height:42px; background:linear-gradient(to right,#2563EB,#20C997); border:none; border-radius:8px; color:white; font-size:14px; font-weight:700; cursor:pointer; }
    </style>
</head>
<body>
<div class="root">

    <div class="left-panel">
        <span class="brand-title">UniEarn</span>
        <span class="brand-subtitle" style="margin-top:10px;">Verify Your Status</span>
        <span class="brand-subtitle" style="font-size:14px;margin-top:5px;">Students only platform</span>
    </div>

    <div class="form-panel" style="overflow-y:auto; padding:30px 50px;">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# Progress #}
        <div class="progress-wrap">
            <div class="step-box"><div class="step-circle step-completed">1</div><span class="step-label label-completed">Account</span></div>
            <span class="step-line">━</span>
            <div class="step-box"><div class="step-circle step-completed">2</div><span class="step-label label-completed">Profile</span></div>
            <span class="step-line">━</span>
            <div class="step-box"><div class="step-circle step-active">3</div><span class="step-label label-active">Verify</span></div>
            <span class="step-line-inactive">━</span>
            <div class="step-box"><div class="step-circle step-inactive">4</div><span class="step-label label-inactive">Portfolio</span></div>
        </div>

        <h1 class="form-title">Student Verification</h1>
        <p class="form-subtitle" style="margin-bottom:20px;">Prove you're a student</p>

        <div class="info-box">
            <p><strong>Why do we need this?</strong><br>
            UniEarn is exclusively for student freelancers. We verify all freelancers to maintain platform integrity and protect clients.</p>
        </div>

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}, 'action': path('freelancer_verify')}) }}

            <div class="verify-box">
                <p style="font-size:16px; margin-bottom:12px;">🎓 <strong>Upload Student Card</strong></p>
                <p style="font-size:13px; font-weight:600; margin-bottom:8px;">📋 Requirements:</p>
                <span class="requirement">✓ Clear photo or scan of your student card</span>
                <span class="requirement">✓ Card must be valid for current academic year</span>
                <span class="requirement">✓ All text must be readable</span>
                <span class="requirement">✓ Accepted formats: JPG, PNG, PDF (max 5MB)</span>

                <hr style="margin:15px 0; border-color:#bfdbfe;">

                <div class="field-wrap" style="margin-bottom:0;">
                    {{ form_label(form.studentCardFile) }}
                    {{ form_widget(form.studentCardFile, {'attr': {'accept': 'image/*,.pdf'}}) }}
                    {{ form_errors(form.studentCardFile) }}
                </div>
            </div>

            <div class="btn-row">
                <a href="{{ path('freelancer_setup') }}" class="back-button">Back</a>
                <button type="submit" class="next-button">Next →</button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
</body>
</html>
