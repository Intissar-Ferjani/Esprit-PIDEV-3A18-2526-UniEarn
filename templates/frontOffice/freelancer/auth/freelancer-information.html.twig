<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Freelancer Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/signup.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css" />
</head>
<body>
<div class="auth-layout">

    <div class="auth-left">
        <div class="brand">
            <img src="{{ asset('images/logoUniEarn.png') }}" alt="UniEarn" class="brand-logo">
            <span class="brand-name">UniEarn</span>
        </div>
        <div class="auth-left-body">
            <h2>Build your profile!</h2>
            <p>Showcase your skills and start earning with your expertise as a student freelancer.</p>
            <div class="feature-list">
                <div class="feature-item"><div class="feature-dot">💼</div><span>Set your hourly rate</span></div>
                <div class="feature-item"><div class="feature-dot">🛠️</div><span>Add your skills & expertise</span></div>
                <div class="feature-item"><div class="feature-dot">📄</div><span>Upload your CV</span></div>
                <div class="feature-item"><div class="feature-dot">✍️</div><span>Write your bio</span></div>
            </div>
        </div>
        <div class="auth-left-footer">© 2025 UniEarn. All rights reserved.</div>
    </div>

    <div class="auth-right">
        <div class="auth-card">

            <div class="progress-wrap">
                <div class="step-box">
                    <div class="step-circle step-completed">✓</div>
                    <span class="step-label label-completed">Account</span>
                </div>
                <div class="step-connector"></div>
                <div class="step-box">
                    <div class="step-circle step-active">2</div>
                    <span class="step-label label-active">Profile</span>
                </div>
                <div class="step-connector-inactive"></div>
                <div class="step-box">
                    <div class="step-circle step-inactive">3</div>
                    <span class="step-label label-inactive">Verify</span>
                </div>
                <div class="step-connector-inactive"></div>
                <div class="step-box">
                    <div class="step-circle step-inactive">4</div>
                    <span class="step-label label-inactive">Portfolio</span>
                </div>
            </div>

            <div class="auth-card-header">
                <h1>Freelancer Profile</h1>
                <p>Tell us about your skills and experience</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-wrap">
                        <div class="flash flash-{{ label }}">{{ label == 'error' ? '✕' : '✓' }} {{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% if not form.vars.valid %}
                <div class="flash-wrap">
                    <div class="flash flash-error">Please fix the errors below.</div>
                    <div style="color: red; margin-bottom: 10px;">{{ form_errors(form) }}</div>
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}, 'action': path('freelancer_setup')}) }}

                <div class="form-divider">Rate</div>

                <div class="field">
                    <label class="field-label">Hourly Rate</label>
                    <div class="input-prefix-wrap">
                        <span class="currency-symbol">TND/h</span>
                        {{ form_widget(form.pricePerHour, {'attr': {'class': 'field-input', 'placeholder': '0.00'}}) }}
                    </div>
                    <div class="field-errors">{{ form_errors(form.pricePerHour) }}</div>
                </div>

                <div class="form-divider">Skills</div>

                <div class="field">
                    <label class="field-label">Your Skills</label>
                    {{ form_widget(form.skills, {'attr': {'class': 'field-input', 'placeholder': 'e.g. PHP, JavaScript, Python'}}) }}
                    <div class="field-errors">{{ form_errors(form.skills) }}</div>
                </div>

                <div class="form-divider">About You</div>

                <!-- ═══ CV Upload + AI Bio Section ═══ -->
                <div class="upload-wrapper">
                    <div class="upload-card" style="background:#f8faff; border-color:#c7d7f5;">
                        <div class="upload-header">
                            <div>
                                <h4>📄 Upload Your CV</h4>
                                <p>We'll auto-generate your bio using AI</p>
                            </div>
                        </div>

                        <div class="upload-action">
                            {{ form_widget(form.cvFile, { attr: { class: 'cv-input' } }) }}

                            <button type="button" class="upload-btn" id="cvUploadBtn">
                                Select file
                            </button>

                            <span class="file-chip hidden" id="cvFileChip">
                                <span class="file-name" id="cvFileName"></span>
                                <span class="remove-file" id="cvRemoveFile">✕</span>
                            </span>
                        </div>

                        <div style="margin-top:8px; font-size:11px; color:#94a3b8;">✓ Only accepted format are JPG, PNG or PDF · max 5 MB</div>

                        <div id="ai-status" style="display:none; margin-top:12px; padding:10px 14px; border-radius:8px; font-size:12px; font-weight:600;"></div>

                        <div class="field-errors">{{ form_errors(form.cvFile) }}</div>
                    </div>
                </div>

                <!-- ═══ Professional Bio ═══ -->
                <div class="field" style="position:relative;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                        <label class="field-label" style="margin:0;">Professional Bio</label>
                        <span id="bioSpinner" style="display:none; animation: spin 0.8s linear infinite; font-size:14px;">⟳</span>
                    </div>
                    {{ form_widget(form.bio, {'attr': {'class': 'field-input', 'rows': 5, 'placeholder': 'Upload your CV above to auto-generate, or write manually…'}}) }}
                    <div style="margin-top:4px; font-size:11px; color:#94a3b8;">ℹ Between 50 and 500 characters · AI-generated bio is fully editable</div>
                    <div class="field-errors">{{ form_errors(form.bio) }}</div>
                </div>

                <div class="btn-row">
                    <a href="{{ path('user_signup') }}" class="back-button">← Back</a>
                    <button type="submit" class="btn-submit">Next →</button>
                </div>

            {{ form_end(form) }}

<style>
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>
<script src="https://cdn.jsdelivr.net/npm/@yaireo/tagify"></script>
<script>
// ── Skills Tags (Tagify) ──
document.addEventListener('DOMContentLoaded', function() {
    const skillsInput = document.getElementById('{{ form.skills.vars.id }}');
    
    if (skillsInput) {
        var tagify = new Tagify(skillsInput, {
            originalInputValueFormat: valuesArr => valuesArr.map(item => item.value).join(','),
            enforceWhitelist: false,
            dropdown: {
                maxItems: 20,           
                classname: "tags-look",
                enabled: 0,             
                closeOnSelect: false    
            }
        });

        let controller;

        tagify.on('input', function(e) {
            var value = e.detail.value;
            tagify.whitelist = null;

            controller && controller.abort();
            controller = new AbortController();

            tagify.loading(true).dropdown.hide();

            fetch('/api/skills?q=' + value, {signal:controller.signal})
                .then(RES => RES.json())
                .then(function(newWhitelist){
                    tagify.whitelist = newWhitelist;
                    tagify.loading(false).dropdown.show(value);
                });
        });
    }
});

// ── CV Upload + AI Bio Generation ──
const cvInput     = document.getElementById('{{ form.cvFile.vars.id }}');
const cvUploadBtn = document.getElementById('cvUploadBtn');
const cvFileChip  = document.getElementById('cvFileChip');
const cvFileName  = document.getElementById('cvFileName');
const cvRemove    = document.getElementById('cvRemoveFile');
const aiStatus    = document.getElementById('ai-status');
const bioField    = document.getElementById('{{ form.bio.vars.id }}');
const bioSpinner  = document.getElementById('bioSpinner');

cvUploadBtn.addEventListener('click', () => cvInput.click());

cvInput.addEventListener('change', async () => {
    if (cvInput.files.length > 0) {
        const file = cvInput.files[0];
        cvFileName.textContent = file.name;
        cvFileChip.classList.remove('hidden');

        // Auto-trigger AI bio generation
        await generateBioFromCv(file);
    }
});

cvRemove.addEventListener('click', () => {
    cvInput.value = '';
    cvFileChip.classList.add('hidden');
    aiStatus.style.display = 'none';
});

async function generateBioFromCv(file) {
    // Show loading state
    aiStatus.textContent = '✨ Analyzing CV and generating bio with AI...';
    aiStatus.style.display = 'block';
    aiStatus.style.background = '#eff6ff';
    aiStatus.style.color = '#2563EB';
    aiStatus.style.border = '1.5px solid #bfdbfe';
    bioSpinner.style.display = 'inline-block';
    bioField.placeholder = 'Generating your professional bio with AI...';
    cvUploadBtn.disabled = true;

    const formData = new FormData();
    formData.append('cvFile', file);

    try {
        const response = await fetch("{{ path('freelancer_generate_bio') }}", {
            method: 'POST',
            body: formData
        });

        const result = await response.json();

        if (result.success && result.bio) {
            bioField.value = result.bio;
            aiStatus.textContent = ' Bio generated! Feel free to edit it.';
            aiStatus.style.background = '#f0fdf4';
            aiStatus.style.color = '#16a34a';
            aiStatus.style.border = '1.5px solid #bbf7d0';
        } else {
            const msg = result.failMessage || result.message || 'Could not generate bio.';
            aiStatus.textContent = '❌ ' + msg;
            aiStatus.style.background = '#fef2f2';
            aiStatus.style.color = '#dc2626';
            aiStatus.style.border = '1.5px solid #fecaca';
            bioField.placeholder = 'Tell clients about yourself, your experience, and what makes you unique...';
        }
    } catch (error) {
        console.error('Bio generation error:', error);
        aiStatus.textContent = '❌ An error occurred. Please write your bio manually.';
        aiStatus.style.background = '#fef2f2';
        aiStatus.style.color = '#dc2626';
        aiStatus.style.border = '1.5px solid #fecaca';
    } finally {
        bioSpinner.style.display = 'none';
        cvUploadBtn.disabled = false;
    }
}
</script>
</body>
</html>