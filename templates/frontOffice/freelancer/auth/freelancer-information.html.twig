<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – Freelancer Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/signup.css') }}">
</head>
<body>
<div class="auth-layout">

    <div class="auth-left">
        <div class="brand">
            <img src="{{ asset('images/logoUniEarn.png') }}" alt="UniEarn" class="brand-logo">
            <span class="brand-name">UniEarn</span>
        </div>
        <div class="auth-left-body">
            <h2>Build your profile!</h2>
            <p>Showcase your skills and start earning with your expertise as a student freelancer.</p>
            <div class="feature-list">
                <div class="feature-item"><div class="feature-dot">💼</div><span>Set your hourly rate</span></div>
                <div class="feature-item"><div class="feature-dot">🛠️</div><span>Add your skills & expertise</span></div>
                <div class="feature-item"><div class="feature-dot">📄</div><span>Upload your CV</span></div>
                <div class="feature-item"><div class="feature-dot">✍️</div><span>Write your bio</span></div>
            </div>
        </div>
        <div class="auth-left-footer">© 2025 UniEarn. All rights reserved.</div>
    </div>

    <div class="auth-right">
        <div class="auth-card">

            <div class="progress-wrap">
                <div class="step-box">
                    <div class="step-circle step-completed">✓</div>
                    <span class="step-label label-completed">Account</span>
                </div>
                <div class="step-connector"></div>
                <div class="step-box">
                    <div class="step-circle step-active">2</div>
                    <span class="step-label label-active">Profile</span>
                </div>
                <div class="step-connector-inactive"></div>
                <div class="step-box">
                    <div class="step-circle step-inactive">3</div>
                    <span class="step-label label-inactive">Verify</span>
                </div>
                <div class="step-connector-inactive"></div>
                <div class="step-box">
                    <div class="step-circle step-inactive">4</div>
                    <span class="step-label label-inactive">Portfolio</span>
                </div>
            </div>

            <div class="auth-card-header">
                <h1>Freelancer Profile</h1>
                <p>Tell us about your skills and experience</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-wrap">
                        <div class="flash flash-{{ label }}">{{ label == 'error' ? '✕' : '✓' }} {{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% if not form.vars.valid %}
                <div class="flash-wrap">
                    <div class="flash flash-error">Please fix the errors below.</div>
                    <div style="color: red; margin-bottom: 10px;">{{ form_errors(form) }}</div>
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}, 'action': path('freelancer_setup')}) }}

                <div class="form-divider">Rate</div>

                <div class="field">
                    <label class="field-label">Hourly Rate</label>
                    <div class="input-prefix-wrap">
                        <span class="currency-symbol">TND/h</span>
                        {{ form_widget(form.pricePerHour, {'attr': {'class': 'field-input', 'placeholder': '0.00'}}) }}
                    </div>
                    <div class="field-errors">{{ form_errors(form.pricePerHour) }}</div>
                </div>

                <div class="form-divider">Skills</div>

                <div class="field">
                    <label class="field-label">Your Skills</label>
                    <div class="skill-tags-wrap" id="skillTagsWrap">
                        <input type="text" id="skillTypingInput" class="skill-typing-input" placeholder="Type a skill and press Enter…">
                    </div>
                    {{ form_widget(form.skills, {'attr': {'style': 'display:none'}}) }}
                    <div class="field-errors">{{ form_errors(form.skills) }}</div>
                </div>

                <div class="form-divider">About You</div>

                <div class="field">
                    {{ form_label(form.bio) }}
                    {{ form_widget(form.bio, {'attr': {'class': 'field-input', 'rows': 3, 'placeholder': 'Tell clients about yourself…'}}) }}
                    <div class="field-errors">{{ form_errors(form.bio) }}</div>
                </div>


                <div class="form-divider">Documents</div>

                <div class="upload-wrapper">
                    <div class="upload-card">
                        <div class="upload-header">
                            <div>
                                <h4>Upload your CV</h4>
                                <p>PDF only • Maximum size 5MB</p>
                            </div>
                        </div>

                        <div class="upload-action">
                            {{ form_widget(form.cvFile, { attr: { class: 'cv-input' } }) }}

                            <button type="button" class="upload-btn">
                                Select file
                            </button>

                            <span class="file-chip hidden">
                                <span class="file-name"></span>
                                <span class="remove-file">✕</span>
                            </span>
                        </div>

                        <div class="field-errors">
                            {{ form_errors(form.cvFile) }}
                        </div>
                    </div>
                </div>

                <div class="btn-row">
                    <a href="{{ path('user_signup') }}" class="back-button">← Back</a>
                    <button type="submit" class="btn-submit">Next →</button>
                </div>

            {{ form_end(form) }}

<script>
const tags = [];
const wrap = document.getElementById('skillTagsWrap');
const typeInput = document.getElementById('skillTypingInput');
const hidden = document.getElementById('{{ form.skills.vars.id }}');

function renderTags() {
    wrap.querySelectorAll('.skill-tag').forEach(t => t.remove());
    tags.forEach((skill, i) => {
        const tag = document.createElement('span');
        tag.className = 'skill-tag';
        tag.innerHTML = skill + '<span class="skill-tag-remove" data-i="' + i + '">✕</span>';
        tag.querySelector('.skill-tag-remove').onclick = () => { tags.splice(i, 1); renderTags(); };
        wrap.insertBefore(tag, typeInput);
    });
    if (hidden) hidden.value = tags.join(',');
}

function addSkill(value) {
    const skill = value.trim();
    if (skill && !tags.includes(skill)) { tags.push(skill); renderTags(); }
}

typeInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addSkill(typeInput.value); typeInput.value = ''; }
});
typeInput.addEventListener('blur', () => { if (typeInput.value.trim()) { addSkill(typeInput.value); typeInput.value = ''; } });
</script>
<script>
const fileInput = document.querySelector('.cv-input');
const uploadBtn = document.querySelector('.upload-btn');
const fileChip = document.querySelector('.file-chip');
const fileName = document.querySelector('.file-name');
const removeBtn = document.querySelector('.remove-file');

uploadBtn.addEventListener('click', () => fileInput.click());

fileInput.addEventListener('change', () => {
    if (fileInput.files.length > 0) {
        fileName.textContent = fileInput.files[0].name;
        fileChip.classList.remove('hidden');
    }
});

removeBtn.addEventListener('click', () => {
    fileInput.value = '';
    fileChip.classList.add('hidden');
});
</script>
</body>
</html>