<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UniEarn Admin – Users</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
</head>
<body class="dashboard-body">
<div class="dashboard-layout">

    {% include 'backOffice/_sidebar.html.twig' with {'active': 'users'} %}

    <div class="dashboard-main">
        <div class="top-bar">
            <span class="top-bar-title">👥 User Management</span>
            <div class="top-bar-right">
                <a href="{{ path('admin_dashboard') }}" style="color:#2563EB;text-decoration:none;font-size:13px;">← Back to Dashboard</a>
            </div>
        </div>

        <div class="dashboard-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {# ── Search & Filter bar ── #}
            <div class="content-section" style="margin-bottom:20px;padding:16px 24px;">
                <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
                    <input type="text" id="searchInput" class="search-input"
                           placeholder="🔍 Search by name or email..."
                           style="width:280px;" onkeyup="filterTable()">
                    <select id="roleFilter" class="filter-select" onchange="filterTable()">
                        <option value="">All Roles</option>
                        <option value="FREELANCER">Freelancer</option>
                        <option value="CLIENT">Client</option>
                        <option value="ADMIN">Admin</option>
                    </select>
                    <select id="statusFilter" class="filter-select" onchange="filterTable()">
                        <option value="">All Statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                    <span id="resultCount" style="font-size:13px;color:#64748b;margin-left:auto;"></span>
                </div>
            </div>

            {# ── Table ── #}
            <div class="content-section" style="padding:0;overflow:hidden;">
                <table id="usersTable" style="width:100%;border-collapse:collapse;">
                    <thead>
                        <tr>
                            <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">#</th>
                            <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Name</th>
                            <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Email</th>
                            <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Role</th>
                            <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Status</th>
                            <th style="background:#2563EB;color:white;padding:13px 16px;text-align:left;font-size:13px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr class="user-row"
                            data-name="{{ user.name | lower }}"
                            data-email="{{ user.email | lower }}"
                            data-role="{{ user.role }}"
                            data-status="{{ user.isActivated ? 'active' : 'inactive' }}"
                            style="border-bottom:1px solid #e2e8f0;transition:background .15s;">
                            <td style="padding:12px 16px;color:#64748b;font-size:13px;">{{ user.idUser }}</td>
                            <td style="padding:12px 16px;">
                                <div style="display:flex;align-items:center;gap:10px;">
                                    {% if user.profilePicturePath %}
                                        <img src="{{ asset(user.profilePicturePath) }}"
                                             style="width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid #e2e8f0;">
                                    {% else %}
                                        <div style="width:34px;height:34px;border-radius:50%;background:#e8f0fe;display:flex;align-items:center;justify-content:center;font-size:14px;">
                                            {{ user.role == 'CLIENT' ? '👤' : '💼' }}
                                        </div>
                                    {% endif %}
                                    <span style="font-weight:600;color:#1e293b;font-size:14px;">{{ user.name }}</span>
                                </div>
                            </td>
                            <td style="padding:12px 16px;color:#64748b;font-size:13px;">{{ user.email }}</td>
                            <td style="padding:12px 16px;">
                                {% if user.role == 'FREELANCER' %}
                                    <span class="pill pill-blue" style="font-size:11px;">{{ user.role }}</span>
                                {% elseif user.role == 'CLIENT' %}
                                    <span class="pill pill-green" style="font-size:11px;">{{ user.role }}</span>
                                {% else %}
                                    <span class="pill pill-purple" style="font-size:11px;">{{ user.role }}</span>
                                {% endif %}
                            </td>
                            <td style="padding:12px 16px;">
                                {% if user.isActivated %}
                                    <span class="pill pill-green" style="font-size:11px;">Active</span>
                                {% else %}
                                    <span style="background:#fee2e2;color:#991b1b;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;">Inactive</span>
                                {% endif %}
                            </td>
                            <td style="padding:12px 16px;">
                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                    <a href="{{ path('admin_user_show', {id: user.idUser}) }}"
                                       class="btn-edit" style="padding:5px 12px;font-size:12px;">View</a>

                                    <form method="post" action="{{ path('admin_user_toggle', {id: user.idUser}) }}" style="display:inline;">
                                        <button type="submit"
                                                class="btn-edit"
                                                style="padding:5px 12px;font-size:12px;background:{{ user.isActivated ? '#f59e0b' : '#16a34a' }};">
                                            {{ user.isActivated ? 'Deactivate' : 'Activate' }}
                                        </button>
                                    </form>

                                    <form method="post" action="{{ path('admin_user_delete', {id: user.idUser}) }}"
                                          onsubmit="return confirm('Delete {{ user.name }}? This cannot be undone.')"
                                          style="display:inline;">
                                        <button type="submit"
                                                class="btn-edit"
                                                style="padding:5px 12px;font-size:12px;background:#ef4444;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align:center;padding:40px;color:#94a3b8;">
                                No users found.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<script>
function filterTable() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const role   = document.getElementById('roleFilter').value;
    const status = document.getElementById('statusFilter').value;
    const rows   = document.querySelectorAll('.user-row');
    let visible  = 0;

    rows.forEach(row => {
        const nameMatch   = row.dataset.name.includes(search) || row.dataset.email.includes(search);
        const roleMatch   = !role   || row.dataset.role   === role;
        const statusMatch = !status || row.dataset.status === status;

        if (nameMatch && roleMatch && statusMatch) {
            row.style.display = '';
            visible++;
        } else {
            row.style.display = 'none';
        }
    });

    document.getElementById('resultCount').textContent =
        visible + ' user' + (visible !== 1 ? 's' : '') + ' shown';
}

// Init count on load
filterTable();

// Hover effect
document.querySelectorAll('.user-row').forEach(row => {
    row.addEventListener('mouseenter', () => row.style.background = '#f8fafc');
    row.addEventListener('mouseleave', () => row.style.background = '');
});
</script>
</body>
</html>