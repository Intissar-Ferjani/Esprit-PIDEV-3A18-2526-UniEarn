<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UniEarn – {% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    
    {# ── Face-API (Local AI) ── #}
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <style>
        .ai-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            margin-top: 12px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #64748b;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        .ai-status-badge.ai-loading { background: #eff6ff; color: #2563eb; border-color: #bfdbfe; }
        .ai-status-badge.ai-success { background: #f0fdf4; color: #16a34a; border-color: #bbf7d0; }
        .ai-status-badge.ai-error   { background: #fef2f2; color: #ef4444; border-color: #fecaca; }
        
        .ai-pulse {
            width: 8px; height: 8px; border-radius: 50%; background: currentColor;
            animation: ai-pulse-anim 1.5s infinite;
        }
        @keyframes ai-pulse-anim {
            0% { transform: scale(0.9); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.5; }
            100% { transform: scale(0.9); opacity: 1; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>